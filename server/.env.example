PORT=3001
SMTP_HOST=localhost
SMTP_PORT=25
CONTACT_TO=dr.nery.klaudia@nerymed.hu
CONTACT_TO_HAZIRVOS=nerymedkft@gmail.com
# The local SMTP relay is not authoritative for nerymed.hu (no SPF/DKIM/MX there) — it only
# has records for the other domain hosted on this server. A From: address on nerymed.hu gets
# rejected/spam-flagged by major providers (Gmail etc.). Use an address on a domain this
# server actually sends for.
CONTACT_FROM=nerymed-noreply@working-domain-on-server.fqdn
ALLOWED_ORIGIN=https://nerymed.hu
# Optional test mode: a request with header "X-Test-Token: <CONTACT_TEST_TOKEN>" is sent to
# CONTACT_TEST_TO instead of the real inbox (subject prefixed [TEST]). Leave unset to disable.
# CONTACT_TEST_TO=you@example.com
# CONTACT_TEST_TOKEN=long-random-string
