---
const year = new Date().getFullYear();
---

<footer
  class="relative"
  style="background-image: url('/images/footer-bg.png'); background-size: cover; background-position: center top;"
>
  <!-- Light gradient overlay so text is readable -->
  <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(255,255,255,0.93) 0%, rgba(216,239,255,0.88) 100%);"></div>

  <div class="relative container mx-auto px-4 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Brand -->
      <div>
        <img src="/images/nerymed-logo-footer.png" alt="NeryMed" class="h-16 w-auto mb-4" />
        <p class="text-sm text-gray-600 leading-relaxed">
          Segítünk az egészség felé vezető úton! Lépjen velünk kapcsolatba egyszerűen.
        </p>
      </div>

      <!-- Oldalak -->
      <div>
        <h3 class="text-blue-900 font-semibold mb-4">Oldalak</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/bemutatkozas" class="text-gray-600 hover:text-orange-500 transition-colors">Bemutatkozás</a></li>
          <li><a href="/eletmodorvoslas/cegeknek" class="text-gray-600 hover:text-orange-500 transition-colors">Életmódorvoslás – Cégeknek</a></li>
          <li><a href="/eletmodorvoslas/maganszemelyek" class="text-gray-600 hover:text-orange-500 transition-colors">Életmódorvoslás – Magánszemélyeknek</a></li>
          <li><a href="/foglalkozas-egeszsegugy" class="text-gray-600 hover:text-orange-500 transition-colors">Foglalkozás-egészségügy</a></li>
          <li><a href="/haziorvos" class="text-gray-600 hover:text-orange-500 transition-colors">Háziorvos</a></li>
          <li><a href="/insumed" class="text-gray-600 hover:text-orange-500 transition-colors">Insumed</a></li>
        </ul>
      </div>

      <!-- Kapcsolat -->
      <div>
        <h3 class="text-blue-900 font-semibold mb-4">Kapcsolat</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-orange-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+36204625517" class="text-gray-600 hover:text-orange-500 transition-colors">+36 20 462 5517</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-orange-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+3623362291" class="text-gray-600 hover:text-orange-500 transition-colors">06 23 362-291</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-orange-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:nerymedkft@gmail.com" class="text-gray-600 hover:text-orange-500 transition-colors">nerymedkft@gmail.com</a>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-gray-300 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-gray-500">
      <p>© {year} NeryMed Kft. Minden jog fenntartva.</p>
      <div class="flex gap-4">
        <a href="/adatvedelem" class="hover:text-orange-500 transition-colors">Adatvédelem</a>
        <a href="/cookie" class="hover:text-orange-500 transition-colors">Cookie-k</a>
      </div>
    </div>
  </div>
</footer>
