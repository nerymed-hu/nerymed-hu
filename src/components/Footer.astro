---
const year = new Date().getFullYear();

const blogPosts = [
  { title: 'Vegán-növényi étrend: megéri odafigyelni a megfelelő tápanyagbevitelre', slug: 'vegan-novenyi-etrend-megeri-odafigyelni-a-megfelelo-tapanyagbevitelre' },
  { title: 'A sportolók teljesítménynövelése Insumed étrenddel', slug: 'sport-teljesitmenynoveles-insumed-etrend' },
  { title: 'K. Zsófia életmódváltása: orvosi támogatással a tartós fogyásért', slug: 'eletmodvaltas-dieta-fogyas' },
];
---

<footer
  class="relative"
  style="background-image: url('/images/footer-bg.png'); background-size: cover; background-position: center top;"
>
  <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(255,255,255,0.93) 0%, rgba(216,239,255,0.92) 100%);"></div>

  <div class="relative container mx-auto px-4 pt-14 pb-0">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-10">

      <!-- Brand + social -->
      <div>
        <img src="/images/nerymed-logo-footer.png" alt="NeryMed" class="h-16 w-auto mb-4" />
        <p class="text-sm text-gray-600 leading-relaxed mb-5">
          Segítünk az egészség felé vezető úton! Lépjen velünk kapcsolatba egyszerűen.
        </p>
        <div class="flex gap-3">
          <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook"
            class="w-9 h-9 bg-blue-600 hover:bg-orange-500 rounded-full flex items-center justify-center transition-colors">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
          <a href="mailto:nerymedkft@gmail.com" aria-label="E-mail"
            class="w-9 h-9 bg-blue-600 hover:bg-orange-500 rounded-full flex items-center justify-center transition-colors">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 512 512">
              <path d="M464 64H48C21.49 64 0 85.49 0 112v288c0 26.51 21.49 48 48 48h416c26.51 0 48-21.49 48-48V112c0-26.51-21.49-48-48-48zm0 48v40.805c-22.422 18.259-58.168 46.651-134.587 106.49-16.841 13.247-50.201 45.072-73.413 44.701-23.208.375-56.579-31.459-73.413-44.701C106.18 199.465 70.425 171.067 48 152.805V112h416zM48 400V214.398c22.914 18.251 55.409 43.862 104.938 82.646 21.857 17.205 60.134 55.186 103.062 54.955 42.717.231 80.509-37.199 103.053-54.947 49.528-38.783 82.032-64.401 104.947-82.653V400H48z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Oldalak -->
      <div>
        <h3 class="text-blue-900 font-semibold mb-4">Oldalak</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/bemutatkozas" class="text-gray-600 hover:text-orange-500 transition-colors">Bemutatkozás</a></li>
          <li><a href="/eletmodorvoslas/cegeknek" class="text-gray-600 hover:text-orange-500 transition-colors">Életmódorvoslás – Cégeknek</a></li>
          <li><a href="/eletmodorvoslas/maganszemelyek" class="text-gray-600 hover:text-orange-500 transition-colors">Életmódorvoslás – Magánszemélyeknek</a></li>
          <li><a href="/foglalkozas-egeszsegugy" class="text-gray-600 hover:text-orange-500 transition-colors">Foglalkozás-egészségügy</a></li>
          <li><a href="/haziorvos" class="text-gray-600 hover:text-orange-500 transition-colors">Háziorvos</a></li>
          <li><a href="/insumed" class="text-gray-600 hover:text-orange-500 transition-colors">Insumed</a></li>
        </ul>
      </div>

      <!-- Blog cikkeink -->
      <div>
        <h3 class="text-blue-900 font-semibold mb-4">Blog cikkeink</h3>
        <ul class="space-y-4 text-sm">
          {blogPosts.map(post => (
            <li>
              <a href={`/blog/${post.slug}`} class="text-gray-600 hover:text-orange-500 transition-colors leading-snug line-clamp-2">
                {post.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Copyright bar — explicit light bg so image doesn't bleed through -->
    <div class="border-t border-gray-200 py-5 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-gray-500 bg-white/60">
      <p>© {year} NeryMed Kft. Minden jog fenntartva.</p>
      <div class="flex gap-4">
        <a href="/adatvedelem" class="hover:text-orange-500 transition-colors">Adatvédelem</a>
        <a href="/cookie" class="hover:text-orange-500 transition-colors">Cookie-k</a>
      </div>
    </div>
  </div>
</footer>
