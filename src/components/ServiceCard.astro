---
export interface Props {
  title: string;
  description: string;
  icon?: string;
  href?: string;
}

const { title, description, icon, href } = Astro.props;
---

<div class="bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col gap-3">
  {icon && (
    <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center text-2xl">
      {icon}
    </div>
  )}
  <h3 class="text-lg font-semibold text-gray-900">{title}</h3>
  <p class="text-gray-600 text-sm leading-relaxed flex-1">{description}</p>
  {href && (
    <a href={href} class="text-blue-700 hover:text-blue-800 text-sm font-medium inline-flex items-center gap-1 mt-1 group">
      Részletek
      <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  )}
</div>
