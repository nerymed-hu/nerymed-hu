---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Kapcsolat – Dr. Nery Klaudia Krisztina"
  description="Vegye fel a kapcsolatot Dr. Nery Klaudia Krisztinával. Bejelentkezés háziorvosi vagy magán rendelésre, konzultációra."
>
  <Header />

  <main>

    <!-- Page heading -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px] text-center">
        <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-3">Kapcsolatfelvétel</p>
        <h1 class="text-4xl lg:text-5xl font-bold text-blue-900 leading-tight mb-4">Kérdése van?</h1>
        <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full"></div>
      </div>
    </section>

    <ContactForm />

  </main>

  <Footer />
</BaseLayout>
