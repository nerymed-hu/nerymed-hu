---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';

const slides = [
  {
    image: '/images/hero-slide-1.png',
    heading: 'Wellbeing orvosi szolgáltatások cégeknek',
    description: 'A wellbeing orvosi szolgáltatásainkkal segítünk az alkalmazottak teljes körű jóllétének támogatásában, beleértve testi, szellemi és érzelmi egészségüket.',
    href: '/eletmodorvoslas/cegeknek',
  },
  {
    image: '/images/hero-slide-2.jpg',
    heading: 'Életmódorvoslás és egészségmegőrzés mindenkinek',
    description: 'Egészségmegőrzés és a krónikus betegségek kezelése és akár visszafordítása is hatékonyan.',
    href: '/eletmodorvoslas/maganszemelyek',
  },
  {
    image: '/images/hero-slide-3.png',
    heading: 'INSUMED diétaterápia',
    description: 'Személyre szabott diétaterápia, amelynek célja a testösszetétel optimalizálása, az izomtömeg megőrzésével és a zsírégetéssel.',
    href: '/insumed',
  },
];

const pillars = [
  { icon: 'ekit-icon ekit-icon-heart-pulse', title: 'Egészség', desc: 'Testi, szellemi és érzelmi egészség komplex támogatása.' },
  { icon: 'ekit-icon ekit-icon-graph-2',     title: 'Növekedés', desc: 'Produktivitás és teljesítmény fejlesztése tudományos alapon.' },
  { icon: 'ekit-icon ekit-icon-star',        title: 'Biztonság', desc: 'Megelőzés, szűrések és folyamatos egészségügyi háttér.' },
];

const services = [
  {
    title: 'Prevenciós vizsgálatok és szűrések',
    desc: 'Rendszeres egészségügyi ellenőrzéseket és vizsgálatokat biztosítunk a betegségek korai felismerése és megelőzése céljából.',
    icon: 'ekit-icon ekit-icon-heart',
    href: '/foglalkozas-egeszsegugy',
  },
  {
    title: 'Mozgásterápia',
    desc: 'Személyre szabott edzésprogramokat alakítunk ki, amelyek segítik az egészséges testtartást, az izomerőt és az általános fizikai kondíciót.',
    icon: 'ekit-icon ekit-icon-battery',
    href: '/eletmodorvoslas/maganszemelyek',
  },
  {
    title: 'Táplálkozási tanácsadás',
    desc: 'Az egészséges életmód és a helyes táplálkozás fontosságára helyezzük a hangsúlyt, ezáltal <strong>betegségek megelőzése és az általános jóllét támogatása érdekében.</strong>',
    icon: 'ekit-icon ekit-icon-vegetables',
    href: '/eletmodorvoslas/maganszemelyek',
  },
  {
    title: 'Alternatív terápiák',
    desc: 'Olyan terápiás módszereket alkalmazunk, amelyek kiegészítik a hagyományos orvoslást, például akupunktúra, masszázs vagy gyógynövényterápia.',
    icon: 'ekit-icon ekit-icon-cog',
    href: '/eletmodorvoslas/cegeknek',
  },
];
---

<BaseLayout
  title="Főoldal"
  description="Dr. Nery Klaudia Krisztina háziorvos és életmódorvos Érden. Életmódorvoslás cégeknek és magánszemélyeknek, foglalkozás-egészségügy, Insumed diétás terápia."
>
  <Header />

  <!-- Hero slider -->
  <div class="relative h-[420px] md:h-[650px] overflow-hidden" id="hero-slider">
    {slides.map((slide, i) => (
      <div
        class={`hero-slide absolute inset-0 transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
        data-index={i}
      >
        <div
          class="absolute inset-0 bg-cover bg-center"
          style={`background-image: url('${slide.image}')`}
        ></div>
        <div class="absolute inset-0" style="background-color: rgba(15, 68, 105, 0.50)"></div>
        <div class="relative h-full flex items-center px-8 md:px-0">
          <div class="md:pl-[20%] md:pr-[38%] w-full">
            <h2 class="text-white text-2xl md:text-5xl font-bold leading-tight mb-4 md:mb-6">
              {slide.heading}
            </h2>
            <p class="text-white/90 text-sm md:text-lg leading-relaxed mb-6 md:mb-8">
              {slide.description}
            </p>
            <a
              href={slide.href}
              class="inline-block bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors text-sm md:text-base"
            >
              Tovább
            </a>
          </div>
        </div>
      </div>
    ))}

    <!-- Prev/Next arrows -->
    <button
      id="slider-prev"
      aria-label="Előző dia"
      class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white/20 hover:bg-white/40 text-white rounded-full flex items-center justify-center transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      id="slider-next"
      aria-label="Következő dia"
      class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white/20 hover:bg-white/40 text-white rounded-full flex items-center justify-center transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Dot indicators -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-10 flex gap-2">
      {slides.map((_, i) => (
        <button
          class={`slider-dot w-2.5 h-2.5 rounded-full transition-colors ${i === 0 ? 'bg-white' : 'bg-white/40'}`}
          data-index={i}
          aria-label={`Dia ${i + 1}`}
        ></button>
      ))}
    </div>
  </div>

  <!-- "Kiknek ajánljuk?" — overlapping card -->
  <div class="container mx-auto px-4 relative z-10 -mt-10 md:-mt-16 mb-0">
    <div class="bg-white rounded-xl shadow-xl overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr_1fr] divide-y md:divide-y-0 md:divide-x divide-gray-100">
        <div class="p-8 md:p-10">
          <h3 class="text-3xl md:text-4xl font-bold text-blue-800 leading-tight mb-4">
            Kiknek ajánljuk?
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">
            Azon cégeknek és magánszemélyeknek, akiknek fontos a testi, szellemi és lelki egészség.
          </p>
        </div>
        {pillars.map(({ icon, title, desc }) => (
          <div class="p-6 md:p-8 flex flex-col items-start md:items-center md:text-center gap-3 group cursor-default">
            <i class={`${icon} text-4xl text-blue-600 group-hover:text-orange-500 transition-colors`} aria-hidden="true"></i>
            <h4 class="font-bold text-blue-700 text-lg">{title}</h4>
            <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- About "Ismerj meg!" -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="flex flex-col lg:flex-row gap-12 items-center">

        <!-- Text: LEFT -->
        <div class="lg:w-1/2 order-2 lg:order-1">
          <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-2">Ismerj meg!</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-5">Dr. Nery Klaudia Krisztina</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            <strong class="text-gray-800">Hivatásom</strong> az egészség és jóllét szolgáltatása. Csapatommal integrált
            orvosi ellátást nyújtunk, figyelembe véve a testi, szellemi és érzelmi egészséget.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            <strong class="text-gray-800">Célunk,</strong> hogy segítsünk ügyfeleinknek elérni és megtartani az
            optimális egészségi állapotot — olyan szolgáltatásokkal, amelyek nemcsak a betegségek
            kezelésére, hanem az egészség megőrzésére és a teljes élet élésére is összpontosítanak.
          </p>
          <a
            href="/bemutatkozas"
            class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-full transition-colors"
          >
            Tovább a bemutatkozáshoz
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Photo: RIGHT with badge and stethoscope -->
        <div class="lg:w-1/2 order-1 lg:order-2 flex justify-center">
          <div class="relative w-72 h-72 lg:w-80 lg:h-80">
            <!-- Stethoscope icon top-right -->
            <div class="absolute -top-4 -right-4 w-20 h-20 bg-blue-600 rounded-full flex items-center justify-center z-10 shadow-lg">
              <i class="ekit-icon ekit-icon-stethoscope text-4xl text-white" aria-hidden="true"></i>
            </div>
            <!-- Circular photo -->
            <img
              src="/images/dr-nery-about.jpg"
              alt="Dr. Nery Klaudia Krisztina"
              class="w-full h-full object-cover object-top rounded-full shadow-2xl border-4 border-white"
            />
            <!-- 15+ badge bottom-LEFT -->
            <div class="absolute -bottom-4 -left-4 w-28 h-28 bg-blue-600 rounded-full flex flex-col items-center justify-center text-white shadow-xl z-10">
              <span class="text-3xl font-bold leading-none">15+</span>
              <span class="text-xs font-semibold mt-1 text-center leading-tight">Év<br/>Tapasztalat</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Wellbeing services -->
  <section class="py-20 bg-blue-50">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="text-center mb-12">
        <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-3">Mi is az a wellbeing orvosi szolgáltatás?</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-5">Munkaerő támogatás<br/>egészségtámogató eszközökkel</h2>
        <p class="text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Cégek számára nyújtott <strong class="text-blue-900">wellbeing orvosi szolgáltatásaink</strong> teljes körű egészségügyi
          támogatást biztosítanak. Ezek az <strong class="text-blue-900">integrált szolgáltatások</strong> nemcsak a <strong class="text-blue-900">fizikai</strong>, hanem a
          <strong class="text-blue-900">mentális és érzelmi egészség</strong> fenntartását is elősegítik, ezzel hozzájárulva a <strong class="text-blue-900">produktivitás
          növekedéséhez</strong> és az alkalmazottak <strong class="text-blue-900">jobb teljesítményéhez.</strong>
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map(({ icon, title, desc, href }) => (
          <a href={href} class="bg-white hover:shadow-md rounded-xl p-6 transition-all flex items-start gap-4 group border border-gray-100 hover:border-orange-200">
            <div class="w-12 h-12 bg-blue-600 group-hover:bg-orange-500 rounded-lg flex items-center justify-center shrink-0 transition-colors">
              <i class={`${icon} text-xl text-white`} aria-hidden="true"></i>
            </div>
            <div>
              <h3 class="font-bold text-blue-900 text-base mb-2">{title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed" set:html={desc}></p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Életmódorvoslás magánszemélyeknek teaser -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="flex flex-col lg:flex-row gap-16 items-start">

        <!-- Left: text + buttons -->
        <div class="lg:w-1/2">
          <p class="text-orange-500 font-semibold text-sm mb-3">Wellbeing szolgáltatások nem csak cégeknek</p>
          <h2 class="text-3xl lg:text-4xl font-normal text-blue-900 leading-tight mb-6">
            Életmódorvoslás<br/>magánszemélyeknek
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Az egészség és a jól lét mindenkinek jár! Wellbeing szolgáltatásaink nemcsak a betegségek
            megelőzésében, hanem azok kezelésében és akár visszafordításában is hatékony szerepet játszanak.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            Ha Ön szeretné megőrizni egészségét, netán valamilyen krónikus betegségben szenved, például a
            cukorbetegség, szív- és érrendszeri betegségek vagy bizonyos autoimmun állapotok – tekintse meg
            szolgáltatásainkat.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="/insumed"
              class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-full transition-colors"
            >
              Insumed terápia <span aria-hidden="true">→</span>
            </a>
            <a
              href="/eletmodorvoslas/maganszemelyek"
              class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-full transition-colors"
            >
              Életmódorvoslás <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Right: 5 bullet points -->
        <div class="lg:w-1/2 space-y-6 pt-2">
          {[
            { title: 'Személyre szabott életmód terv', desc: 'Személyreszabott életmódprogramot állítunk össze, az egészségmegőrzés és az általános jóllét kialakításához.' },
            { title: 'Táplálkozási és mozgásprogramok', desc: 'Egyéni programot alakítunk ki, ahol a táplálkozás és a testmozgás egyensúlyba kerül.' },
            { title: 'Krónikus betegségek megelőzése', desc: 'Segítünk a krónikus betegségek megelőzésében és kezelésében az egészséges életmód által.' },
            { title: 'Teljes körű egészségügyi felmérés', desc: 'A megelőzés kiemelten fontos! Rendelőnkben különböző vizsgálatokkal felmérjük egészségiállapotát.' },
            { title: 'Testösszetétel vizsgálat (BIA mérés)', desc: 'A BIA-mérés (bioimpedancia-analízis) gyors és pontos módja a testösszetétel elemzésének. Megmutatja, hogy a szervezet mennyi zsírt, izmot, víztartalmat és más komponenseket tartalmaz.' },
          ].map(({ title, desc }) => (
            <div class="flex items-start gap-4">
              <span class="text-blue-500 font-bold text-lg leading-none mt-1 shrink-0">»</span>
              <div>
                <h3 class="font-bold text-blue-900 text-base mb-1">{title}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Longevity section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-4xl text-center">
      <h2 class="text-2xl lg:text-3xl font-semibold text-blue-900 leading-snug mb-8">
        A longevity koncepciója az orvostudományban, a táplálkozástudományban és az
        életmódkutatásban is egyre nagyobb figyelmet kap
      </h2>
      <p class="text-gray-600 leading-relaxed text-base">
        <strong class="text-gray-800">A longevity</strong>, vagyis a hosszú és egészséges élet elérése szorosan kapcsolódik az
        <strong class="text-gray-800">életmódorvostanhoz</strong>, hiszen a megfelelő táplálkozás, a rendszeres testmozgás,
        a stresszkezelés és a prevenció együttesen járulnak hozzá az egészség megőrzéséhez.
        A cél nemcsak a betegségek kezelése, hanem azok megelőzése is, így segít hosszú távon
        fenntartani a vitalitást és az aktív életet. A longevity szemlélet tudományos alapokon
        nyugvó stratégiákat kínál a sejtszintű öregedés lassítására, biztosítva, hogy az életévek
        ne csak számban, hanem minőségben is gyarapodjanak.
      </p>
    </div>
  </section>

  <Testimonials />

  <!-- További szolgáltatásaink -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-12">
        <h2 class="text-3xl lg:text-4xl font-semibold text-blue-900">További szolgáltatásaink</h2>
        <p class="text-gray-500 text-sm md:max-w-xs leading-relaxed">Ismerje meg bővebben a további szolgáltatásainkat, és tegyen az egészségéért még ma!</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            icon: 'ekit-icon ekit-icon-profile',
            title: 'Foglalkozás-egészségügy',
            desc: 'Munkahelyi egészségmegőrzés és biztonsági támogatásokat nyújt.',
            href: '/foglalkozas-egeszsegugy',
          },
          {
            icon: 'ekit-icon ekit-icon-physiotherapy',
            title: 'Insumed',
            desc: 'Orvosi diétaterápia túlsúlyosoknak, cukorbetegeknek, 65+, hiányos tápláltságúaknak, vegánoknak, intoleranciával küzdőknek, inzulinrezisztenseknek, PCOS esetén, sportolóknak.',
            href: '/insumed',
          },
          {
            icon: 'ekit-icon ekit-icon-doctor',
            title: 'Háziorvos',
            desc: 'Általános egészségügyi problémák kezelése és gondozása.',
            href: '/haziorvos',
          },
        ].map(({ icon, title, desc, href }) => (
          <div class="flex flex-col items-center text-center p-8 border border-gray-100 rounded-xl shadow-sm hover:shadow-md transition-shadow">
            <div class="w-16 h-16 bg-blue-50 rounded-full flex items-center justify-center mb-5">
              <i class={`${icon} text-3xl text-blue-600`} aria-hidden="true"></i>
            </div>
            <h3 class="font-bold text-blue-900 text-lg mb-3">{title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-6 flex-1">{desc}</p>
            <a
              href={href}
              class="inline-block bg-orange-500 hover:bg-blue-900 text-white font-semibold px-6 py-2.5 rounded-full transition-colors text-sm"
            >
              Tovább
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactForm />

  <Footer />
</BaseLayout>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const dots = document.querySelectorAll<HTMLElement>('.slider-dot');
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(n: number) {
    slides[current].classList.remove('opacity-100');
    slides[current].classList.add('opacity-0');
    dots[current].classList.remove('bg-white');
    dots[current].classList.add('bg-white/40');
    current = ((n % slides.length) + slides.length) % slides.length;
    slides[current].classList.remove('opacity-0');
    slides[current].classList.add('opacity-100');
    dots[current].classList.remove('bg-white/40');
    dots[current].classList.add('bg-white');
  }

  function resetTimer() {
    clearInterval(timer);
    timer = setInterval(() => goTo(current + 1), 6000);
  }

  document.getElementById('slider-next')?.addEventListener('click', () => { goTo(current + 1); resetTimer(); });
  document.getElementById('slider-prev')?.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
  dots.forEach(dot => {
    dot.addEventListener('click', () => { goTo(Number(dot.dataset.index)); resetTimer(); });
  });

  resetTimer();
</script>
