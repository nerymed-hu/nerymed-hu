---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const schedule = [
  { day: 'Hétfő',     hours: '11:30 – 15:30-ig' },
  { day: 'Kedd',      hours: '07:30 – 11:30-ig' },
  { day: 'Szerda',    hours: '14:00 – 18:00-ig' },
  { day: 'Csütörtök', hours: '07:30 – 11:30-ig' },
  { day: 'Péntek',    hours: '07:30 – 11:30-ig' },
];

const urgentYes = [
  { bold: 'Jelentős vérnyomás-kiugrás (180 Hgmm felett),', rest: ' melyet az otthoni vérnyomáscsökkentőkkel nem tud lejjebb vinni a páciens.' },
  { bold: 'Akut allergiás reakció:', rest: ' jelentős bőrpír, csalánkiütés, viszketés.' },
  { bold: 'Természetes halál bekövetkezte', rest: ' (idős és/vagy ismert, súlyos beteg).' },
];

const urgentNo = [
  { bold: 'Torokfájás, köhögés, láz, derék- vagy végtagfájdalom.', rest: ' Ezekkel a panaszokkal a következő háziorvosi rendelést kell felkeresni, addig vény nélkül kapható fájdalom- és lázcsillapító szedése javasolt.' },
  { bold: 'Injekció adása a legtöbbször felesleges és elkerülhető.', rest: ' Szájon át is remekül felszívódnak rendszerint a gyógyszerek.' },
];

const emergencyLeft = [
  'nehézlégzés, mellkasi fájdalom,',
  'vérzéses állapot,',
  'hirtelen fellépő mozgás- vagy beszédképtelenség, a végtagok érzékelésének elvesztése,',
  'ájulás, mérgezés, allergiás reakció,',
  'vérköpés, vérhányás, elhúzódó hányás vagy hasmenés,',
  'a mentális állapot megváltozása, zavartság, szokatlan viselkedés, öngyilkossági gondolatok,',
  'hirtelen fellépő, soha nem tapasztalt erősségű fejfájás, látászavar,',
];

const emergencyRight = [
  'ellátást igénylő seb, égési sérülés,',
  'törött csont, fejsérülés, hirtelen keletkező ízületi fájdalom,',
  'nem szűnő szédülés, gyengeség,',
  'tartós, csillapíthatatlan láz,',
  'fájdalomcsillapító- és görcsoldó terápiára nem enyhülő hasi fájdalom,',
  'szapora és/vagy rendszertelen szívdobogásérzés,',
  '40/perc alatti pulzusszám, melyhez gyengeség, szédülés, a tudatállapot megváltozása, ájulásérzés, illetve eszméletvesztés társul.',
];

const recentNews = [
  { slug: 'munkakori-alkalmassagi-vizsgalat-mit-vizsgal-az-uzemorvos', title: 'Munkaköri alkalmassági vizsgálat: mit vizsgál az üzemorvos?' },
  { slug: 'ingyenes-influenza-elleni-vedooltas', title: 'Ingyenes influenza elleni védőoltás' },
  { slug: 'szamarkohoges-pertussis-elleni-oltas', title: 'Szamárköhögés (pertussis) elleni oltás fontossága' },
  { slug: 'korai-felismeres-eletet-menthet-ingyenes-ldct-tudorakszures-a-koranyi-intezetben', title: 'Korai felismerés életet menthet: ingyenes LDCT tüdőrákszűrés' },
  { slug: 'haziorvos-idopontfoglalas-hir', title: 'Új lehetőség: Országszerte foglalható online időpont' },
  { slug: 'vallalati-wellbeing-egeszseg-eredmenyek', title: 'Vállalati wellbeing – Sikeres céges egészségprogram' },
];

const faqsLeft = [
  {
    q: 'Minden esetben szükséges a háziorvosi ellátáshoz időpontot kérni, amennyiben az orvossal szeretnénk konzultálni?',
    a: 'Igen, kivéve sürgősségi esetekben, mint például lázas állapot, hányás, hasmenés, hirtelen mellkasi nyomás, nehézlégzés, vagy erős fájdalom. Ezekben az esetekben nem szükséges időpontot foglalnia.',
  },
  {
    q: 'Hogyan kérhetek szokásos, rendszeresen szedett gyógyszerekről receptet?',
    a: 'Receptet igényelhet e-mailben, telefonon, személyesen vagy a rendelő falán található postaládába bedobott levélben.',
  },
  {
    q: 'Melyek a beutaló nélkül látogatható szakrendelések?',
    a: 'Az alábbi szakrendelések beutaló nélkül is látogathatók: Urológia, Nőgyógyászat, Bőrgyógyászat, 40 év felett tüdőszűrő vizsgálat, Fül-Orr-Gégészet, Pszichiátria, Sebészet, Szemészet.',
  },
];

const faqsRight = [
  {
    q: 'Táppénzt szeretnék. Mi a teendőm?',
    a: 'A táppénz igénylése személyes orvosi vizsgálathoz vagy legalább telefonos konzultációhoz kötött. E-mailes megkeresés esetén sajnos nem tudunk táppénzes igazolást kiállítani.',
  },
  {
    q: 'Krónikus betegségem van (cukorbetegség, magas vérnyomás stb.), de nincs panaszom. Milyen gyakran kell megjelennem?',
    a: 'Amennyiben panaszmentes és betegsége jól be van állítva, évente legalább egyszer mindenképpen szükséges megjelennie orvosi vizsgálaton, és részt kell vennie az elrendelt vizsgálatokon (labor, EKG, stb.).',
  },
  {
    q: 'Jogosítványt szeretnék hosszabbítani, mi a teendőm?',
    a: 'Előzetesen kérjük, keresse fel háziorvosi rendelőnket e-mailben vagy telefonon, hogy tájékoztathassuk a szükséges vizsgálatokról és szükség esetén beutalót biztosíthassunk.',
  },
];
---

<BaseLayout
  title="Háziorvos"
  description="Háziorvosi rendelés Érden – Dr. Nery Klaudia Krisztina. Rendelési idő: H 11:30–15:30, K/Cs/P 07:30–11:30, Sze 14:00–18:00. Érd, Kossuth Lajos u. 42."
>
  <Header />

  <main>

    <!-- Hero: white bg, 30% image left, 70% text right -->
    <section class="bg-white overflow-hidden">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="flex flex-col lg:flex-row items-end">

          <div class="lg:w-[30%] flex justify-start items-end order-2 lg:order-1 pt-10 lg:pt-0">
            <img
              src="/images/Nery-klaudia-3.jpg"
              alt="Dr. Nery Klaudia Krisztina háziorvos"
              class="h-[380px] lg:h-[520px] w-auto object-cover object-top"
            />
          </div>

          <div class="lg:w-[70%] py-20 lg:pl-12 order-1 lg:order-2">
            <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-3">Háziorvos</p>
            <h1 class="text-4xl lg:text-5xl font-bold text-blue-900 leading-tight mb-3">
              Háziorvosi rendelés Érden
            </h1>
            <h2 class="text-lg text-orange-500 font-semibold mb-2">Dr. Nery Klaudia Krisztina háziorvos</h2>
            <p class="font-bold text-blue-900 mb-6">Érd Kossuth Lajos utca 42.</p>
            <p class="text-gray-600 leading-relaxed mb-8 max-w-xl">
              Szeretettel várom pácienseimet <strong class="text-blue-900">érdi háziorvosi rendelőmben</strong> a megadott időpontokban.
              Sürgős, akut esetekben nem szükséges bejelentkeznie. Amennyiben orvosi tanácsadásra,
              megelőző ellátásra vagy egyéb, nem sürgős ellátásra van szüksége, kérjük,
              <strong class="text-blue-900">foglaljon időpontot előzetesen!</strong>
            </p>
            <a href="#szekcio1" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
              Rendelési idő <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Időpontfoglalás: 50% text + 50% contact boxes -->
    <section id="szekcio1" class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="flex flex-col lg:flex-row gap-12">

          <div class="lg:w-1/2">
            <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-4">Időpontfoglalás</h2>
            <div class="w-10 h-1 bg-blue-500 rounded-full mb-6"></div>
            <p class="text-gray-600 leading-relaxed">
              A rendelés <strong class="text-blue-900">előjegyzés alapján</strong> történik, kivéve akut (napokban hirtelen kialakult)
              <strong class="text-blue-900">megbetegedés esetén.</strong> Lázas, felsőlégúti, egyéb fertőzéses jellegű megbetegedés
              (hányás, hasmenés, kiütés) esetén <strong class="text-blue-900">érdemes előbb telefonálni,</strong> a hosszú várakozási
              idő elkerülése miatt. Ebben az esetben <strong class="text-blue-900">időpont nélkül</strong> soron kívül látjuk el,
              de várakozási idővel számolni kell.
            </p>
          </div>

          <div class="lg:w-1/2 space-y-4">
            <a href="mailto:nerymedkft@gmail.com" class="flex items-center gap-4 p-5 bg-blue-50 hover:bg-blue-100 rounded-xl transition-colors group">
              <div class="w-12 h-12 bg-orange-500 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 mb-0.5">E-mail</p>
                <p class="font-semibold text-blue-900">nerymedkft@gmail.com</p>
              </div>
            </a>
            <a href="tel:+3623362291" class="flex items-center gap-4 p-5 bg-blue-50 hover:bg-blue-100 rounded-xl transition-colors group">
              <div class="w-12 h-12 bg-orange-500 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 mb-0.5">Telefon</p>
                <p class="font-semibold text-blue-900">06 23 362-291</p>
              </div>
            </a>
            <a href="tel:+36204625517" class="flex items-center gap-4 p-5 bg-blue-50 hover:bg-blue-100 rounded-xl transition-colors group">
              <div class="w-12 h-12 bg-orange-500 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 mb-0.5">Mobil</p>
                <p class="font-semibold text-blue-900">+36 20 462 5517</p>
              </div>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Rendelési idők: full-width -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-4">Háziorvos rendelési idők</h2>
        <div class="w-10 h-1 bg-blue-500 rounded-full mb-8"></div>
        <div class="bg-white rounded-xl shadow-[0_0_30px_rgba(0,0,0,0.08)] overflow-hidden max-w-lg">
          <table class="w-full">
            <thead>
              <tr class="bg-blue-900">
                <th class="px-6 py-3 text-left text-blue-100 font-semibold text-sm">Napok</th>
                <th class="px-6 py-3 text-right text-blue-100 font-semibold text-sm">Idő</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {schedule.map(({ day, hours }) => (
                <tr class="hover:bg-blue-50 transition-colors">
                  <td class="px-6 py-4 font-semibold text-blue-900">{day}</td>
                  <td class="px-6 py-4 text-gray-600 text-right font-medium">{hours}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Sürgős esetben -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-2">Sürgős esetben</h2>
        <p class="text-gray-500 italic mb-8">(akut, életveszélyes állapot)</p>
        <div class="flex flex-col sm:flex-row gap-6 max-w-2xl">
          <div class="flex-1 p-6 bg-blue-50 rounded-xl border border-blue-100">
            <p class="font-bold text-blue-900 mb-2">Rendelési időben (8:00–16:00)</p>
            <p class="text-gray-600 text-sm">Hívja a háziorvosát!</p>
          </div>
          <div class="flex-1 p-6 bg-blue-50 rounded-xl border border-blue-100">
            <p class="font-bold text-blue-900 mb-2">Rendelési időn kívül (16:00–8:00)</p>
            <p class="text-gray-600 text-sm">Az ügyelet elérhető a <strong class="text-blue-900">1830-as telefonszámon</strong>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Ügyelet: 40% image left + 60% text right -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="flex flex-col lg:flex-row gap-12 items-start">

          <div class="lg:w-[40%] shrink-0">
            <img
              src="/images/haziorvos.png"
              alt="Helyi háziorvosi ügyelet"
              class="w-[80%] rounded-2xl shadow-md"
            />
          </div>

          <div class="lg:w-[60%]">
            <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-4">Helyi háziorvosi ügyelet</h2>
            <div class="w-10 h-1 bg-blue-500 rounded-full mb-5"></div>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong class="text-blue-900">Fontos:</strong> 2024. február 1-től a Pest megyei ügyeleti rendszer megváltozott.
              Mostantól délután 16 óra után sürgős esetben a <strong class="text-blue-900">1830-as telefonszámot</strong> kell hívni.
            </p>

            <h3 class="font-bold text-blue-900 mb-3">A háziorvosi ügyelet igénybevétele az alábbi esetekben indokolt</h3>
            <ul class="space-y-2 mb-6">
              {urgentYes.map(({ bold, rest }) => (
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="text-green-500 font-bold mt-0.5 shrink-0">✓</span>
                  <span><strong class="text-blue-900">{bold}</strong>{rest}</span>
                </li>
              ))}
            </ul>

            <h3 class="font-bold text-blue-900 mb-3">Az ügyelet igénybevétele az alábbi esetekben NEM indokolt:</h3>
            <ul class="space-y-2">
              {urgentNo.map(({ bold, rest }) => (
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="text-red-400 font-bold mt-0.5 shrink-0">✗</span>
                  <span><strong class="text-blue-900">{bold}</strong>{rest}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </section>

    <!-- Emergency symptoms: two columns -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <p class="text-gray-600 leading-relaxed mb-2">
          Az alábbi tünetek esetén életmentő lehet, ha egyenesen a területileg illetékes
        </p>
        <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-2">
          SÜRGŐSSÉGI OSZTÁLYRA MEN (Szent Imre Kórház),
        </h2>
        <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-8">
          vagy HÍVJA AZ ORSZÁGOS MENTŐSZOLGÁLATOT (112)
        </h2>
        <div class="flex flex-col lg:flex-row gap-6">
          <ul class="lg:w-1/2 space-y-3">
            {emergencyLeft.map(item => (
              <li class="flex items-start gap-3 text-gray-700 text-sm">
                <span class="text-blue-500 shrink-0 mt-0.5 font-bold">›</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <ul class="lg:w-1/2 space-y-3">
            {emergencyRight.map(item => (
              <li class="flex items-start gap-3 text-gray-700 text-sm">
                <span class="text-blue-500 shrink-0 mt-0.5 font-bold">›</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Aktuális híreink -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-4">Aktuális híreink</h2>
        <div class="w-10 h-1 bg-blue-500 rounded-full mb-8"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {recentNews.map(({ slug, title }) => (
            <a
              href={`/blog/${slug}`}
              class="flex items-start gap-3 p-5 rounded-xl border border-gray-200 hover:border-blue-300 bg-white hover:bg-blue-50 transition-colors group"
            >
              <span class="text-blue-500 mt-0.5 shrink-0 font-bold">›</span>
              <span class="text-gray-700 group-hover:text-blue-800 text-sm font-medium leading-snug transition-colors">
                {title}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ: two-column accordion -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-2">GYIK</p>
        <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-3">Gyakori Kérdések</h2>
        <div class="w-10 h-1 bg-blue-500 rounded-full mb-3"></div>
        <p class="text-gray-500 mb-10">Általános kérdése van a szolgáltatással kapcsolatban?</p>
        <div class="flex flex-col lg:flex-row gap-6">
          <div class="lg:w-1/2 rounded-xl shadow-[0_0_30px_rgba(0,0,0,0.08)] overflow-hidden">
            {faqsLeft.map(({ q, a }) => (
              <details class="group border-b border-gray-100 last:border-b-0">
                <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none select-none hover:bg-gray-50 transition-colors">
                  <span class="font-semibold text-blue-900 text-sm pr-4">{q}</span>
                  <svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <div class="px-6 pb-5 pt-1 text-gray-600 text-sm leading-relaxed">{a}</div>
              </details>
            ))}
          </div>
          <div class="lg:w-1/2 rounded-xl shadow-[0_0_30px_rgba(0,0,0,0.08)] overflow-hidden">
            {faqsRight.map(({ q, a }) => (
              <details class="group border-b border-gray-100 last:border-b-0">
                <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none select-none hover:bg-gray-50 transition-colors">
                  <span class="font-semibold text-blue-900 text-sm pr-4">{q}</span>
                  <svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <div class="px-6 pb-5 pt-1 text-gray-600 text-sm leading-relaxed">{a}</div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <ContactForm description="Kérjen időpontot háziorvosi egészségügyi vizsgálatra emailben vagy telefonon (<a href='tel:+3623362291' class='font-bold text-blue-900 hover:text-orange-500 transition-colors'>06 23 362-291</a>)!" />

  </main>

  <Footer />
</BaseLayout>

<style>
  details summary::-webkit-details-marker { display: none; }
</style>
