---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Adatvédelmi tájékoztató" description="NeryMed Kft. adatvédelmi tájékoztatója a GDPR szerint.">
  <Header />

  <main>
    <section class="bg-teal-700 text-white py-16">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold mb-4">Adatvédelmi tájékoztató</h1>
      </div>
    </section>

    <section class="py-16">
      <div class="container mx-auto px-4 max-w-3xl prose prose-gray">
        <!-- TODO: port actual privacy policy text from nerymed.hu/adatvedelem -->
        <p class="text-gray-500 italic">Az adatvédelmi tájékoztató feltöltése folyamatban van.</p>

        <h2>Adatkezelő</h2>
        <p>NeryMed Kft.<br />
        E-mail: nerymedkft@gmail.com<br />
        Telefon: +36 20 462 5517</p>

        <h2>Kezelt adatok köre</h2>
        <p>A kapcsolatfelvételi űrlap kitöltésekor az alábbi adatokat kezeljük: név, e-mail cím, telefonszám, cégnév, üzenet szövege.</p>

        <h2>Az adatkezelés célja</h2>
        <p>A kapcsolatfelvételre érkező megkeresések megválaszolása és az időpontfoglalás lebonyolítása.</p>

        <h2>Az adatkezelés jogalapja</h2>
        <p>Az érintett hozzájárulása (GDPR 6. cikk (1) bekezdés a) pont).</p>

        <h2>Adatmegőrzési idő</h2>
        <p>Az adatokat a kapcsolatfelvétel megválaszolásáig, illetve hozzájárulás visszavonásáig kezeljük.</p>

        <h2>Érintetti jogok</h2>
        <p>Önnek joga van hozzáférni adataihoz, kérni azok helyesbítését, törlését vagy kezelésük korlátozását. Jogsértés esetén a Nemzeti Adatvédelmi és Információszabadság Hatósághoz (naih.hu) fordulhat.</p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
