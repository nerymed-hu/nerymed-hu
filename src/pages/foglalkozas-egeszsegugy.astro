---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const examTypes = [
  {
    title: 'Előzetes vizsgálat',
    desc: 'Ezt a vizsgálatot a munkavállaló <strong class="text-blue-900">alkalmazása előtt</strong> kell elvégezni.',
  },
  {
    title: 'Időszakos vizsgálat',
    desc: 'Rendszerint <strong class="text-blue-900">évente</strong> vagy a munkáltató által meghatározott felülvizsgálati időpontban szükséges.',
  },
  {
    title: 'Soron kívüli vizsgálat',
    desc: 'A munkáltató rendelheti el saját belátása szerint, vagy ha a munkavállaló <strong class="text-blue-900">30 napnál hosszabb betegszabadságon</strong> volt.',
  },
  {
    title: 'Záró vizsgálat',
    desc: 'Különösen fontos a rákkeltő anyagokkal dolgozók esetében, amikor a <strong class="text-blue-900">dolgozó kilép a vállalattól.</strong>',
  },
];

const additionalServices = [
  '<strong class="text-blue-900">Orvosi vélemény</strong> kiadása a munkaalkalmasságról, írásban, szóban vagy digitális formában',
  'Foglalkozási megbetegedések és <strong class="text-blue-900">expozíciós esetek</strong> jelentése, kivizsgálásban való részvétel',
  '<strong class="text-blue-900">Egyéni védőeszközök</strong> kiválasztása és tanácsadás',
  '<strong class="text-blue-900">Munkahelyi kémiai</strong> biztonsági feladatok ellátása',
  '<strong class="text-blue-900">Gépjárművezetői engedélyek</strong> hosszabbítása, beleértve a hivatásos jogosítványokat is',
  '<strong class="text-blue-900">Targoncavezetői jogosítványok</strong> hosszabbításához szükséges vizsgálatok elvégzése',
  '<strong class="text-blue-900">Védőoltások beadása</strong>, az előírások szerinti adminisztrációval',
  'Hatóságok számára <strong class="text-blue-900">egészségügyi dokumentációk</strong> elkészítése és adminisztráció',
];

const categories = [
  {
    title: '"A" kategória',
    items: [
      'A bányászat, kohászat fizikai munkakörei, valamint azon nem fizikai munkakörök munkavállalói, akik az „A" foglalkozás-egészségi osztályt indokoló környezetben töltik munkaidejük több mint 50%-át.',
      'A rákkeltőkkel exponáltak, sugárzó anyagokkal, állatkísérletes munkakörben foglalkoztatottak, korkedvezményre jogosító munkakörben foglalkoztatottak, a vasúti, a légi és vízi közlekedésben dolgozó munkavállalók.',
    ],
  },
  {
    title: '"B" kategória',
    items: [
      'Az alábbi gazdasági tevékenységek fizikai munkaköreinek munkavállalói: mezőgazdaság, vadgazdálkodás, erdőgazdálkodás, építőipar, élelmiszerek és italok gyártása, dohánytermékek gyártása, textíliák gyártása, ruházati termékek gyártása, szőrmekikészítés és festés, bőrkikészítés, bőrtermékek és lábbeli gyártása, fafeldolgozás, kőolaj-feldolgozás és kokszgyártás, vegyi alapanyagok és termékek gyártása, gumi és műanyag termékek gyártása, nemfém ásványi termékek gyártása, nyersanyag visszanyerése hulladékból, szárazföldi és csővezetékes szállítás, vízi szállítás, légi szállítás, bútorgyártás, egészségügyi és szociális ellátás, állategészségügyi tevékenység, nyomdaipari termékek gyártása.',
      'Azok, akik a „B" foglalkozás-egészségi osztályt indokoló munkakörnyezetben töltik munkaidejük több mint 50%-át.',
    ],
  },
  {
    title: '"C" kategória',
    items: [
      'Az „A" foglalkozás-egészségi osztályba nem tartozó ipari, szolgáltató, kutató, illetve számítástechnikai tevékenységgel kapcsolatos fizikai munkakörei.',
      'Valamint azon nem fizikai munkakörök munkavállalói, akik a „C" foglalkozás-egészségi osztályt indokoló munkakörnyezetben töltik munkaidejük több mint 50%-át.',
    ],
  },
  {
    title: '"D" kategória',
    items: [
      'A kutatás-szervezési, kulturális, oktatási és egyéb adminisztratív tevékenységet végző munkavállalók.',
      '„A", „B" és „C" foglalkozás-egészségi osztályba sorolt tevékenységek nem fizikai munkaköreiben dolgozó, más osztályba nem sorolt munkavállalók.',
    ],
  },

];

const logos = [
  { src: '/images/damit.png', alt: 'Damit' },
  { src: '/images/flashnetwork_logo-1.png', alt: 'Flash Network' },
  { src: '/images/MK-maganvervetel.png', alt: 'MK Magánvétel' },
  { src: '/images/mundimed.jpg', alt: 'Mundimed' },
  { src: '/images/magnolia_logo_vector_lgrey-2-scaled-1.jpg', alt: 'Magnolia' },
  { src: '/images/pick-logo.png', alt: 'Pick' },
  { src: '/images/compo-logo.png', alt: 'Compo' },
];
---

<BaseLayout
  title="Foglalkozás-egészségügy"
  description="Munkaköri alkalmassági vizsgálatok és foglalkozás-egészségügyi ellátás cégeknek. Előzetes, időszakos, soron kívüli és záró vizsgálatok Dr. Nery Klaudia Krisztinával."
>
  <Header />

  <main>

    <!-- Hero: white bg, 30% image left, 70% text right -->
    <section class="bg-white overflow-hidden">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="flex flex-col lg:flex-row items-end">

          <!-- Image left 30% -->
          <div class="lg:w-[30%] flex justify-start items-end order-2 lg:order-1 pt-10 lg:pt-0">
            <img
              src="/images/klaudia-uj.jpg"
              alt="Dr. Nery Klaudia Krisztina – foglalkozás-egészségügy"
              class="h-[380px] lg:h-[520px] w-auto object-cover object-top"
              style="box-shadow: -10px -10px 0 0 #0F4469"
            />
          </div>

          <!-- Text right 70% -->
          <div class="lg:w-[70%] py-20 lg:pl-12 order-1 lg:order-2">
            <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-3">Foglalkozás-egészségügy</p>
            <h1 class="text-4xl lg:text-5xl font-bold text-blue-900 leading-tight mb-6">
              Foglalkozás-egészségügyi vizsgálatok a NeryMednél
            </h1>
            <p class="text-gray-600 leading-relaxed mb-8 max-w-xl">
              A magyar jogszabályok értelmében <strong class="text-blue-900">minden munkáltató köteles foglalkozás-egészségügyi ellátást biztosítani a munkavállalói számára.</strong> Ez az előírás a 89/1995. Kormányrendelet alapján — minden szervezett munkavállalásra vonatkozik, <strong class="text-blue-900">még akkor is, ha csak egyetlen alkalmazott van.</strong>
            </p>
            <a
              href="#kapcsolat"
              class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors"
            >
              Kérjen egyedi ajánlatot <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Törvényi háttér: full-width single column -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-4">A vizsgálatok törvényi háttere</h2>
        <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
        <p class="text-gray-600 leading-relaxed max-w-4xl">
          Az 1993. évi XCIII. törvény a munkavédelemről 58. §-a, a 89/1995. kormányrendelet a foglalkozás-egészségügyi alapszolgálatról, a 27/1995. NM rendelet a foglalkozás-egészségügyi szolgáltatásról, a 33/1998. (VI.24.) NM rendelet a munkaköri alkalmassági vizsgálatok rendjéről, valamint az érvényben lévő további rendeletekben előírtak alapján <strong class="text-blue-900">biztosítjuk az Ön cége számára is a foglalkozás-egészségügyi szolgáltatást,</strong> figyelembe véve az egyedi igényeket is!
        </p>
      </div>
    </section>

    <!-- Image 40% left + Exam types 60% right -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="flex flex-col lg:flex-row gap-12 items-start">

          <div class="lg:w-[40%] shrink-0">
            <img
              src="/images/foglalkozas-egeszsgeugy-alkalmassagi.png"
              alt="Foglalkozás-egészségügyi alkalmassági vizsgálat"
              class="w-[85%] rounded-2xl shadow-md"
            />
          </div>

          <div class="lg:w-[60%]">
            <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-3">Mely munkaköri alkalmassági vizsgálatokra jelentkezhet be hozzánk?</h2>
            <div class="w-12 h-1 bg-blue-500 rounded-full mb-5"></div>
            <p class="text-gray-500 leading-relaxed mb-8">
              A munkaalkalmassági vizsgálatok különböző típusai segítenek biztosítani, hogy a munkavállalók egészségileg alkalmasak legyenek az adott munkakör betöltésére. Rendelőnkben az alábbi vizsgálat típusokra jelentkezhet:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {examTypes.map(({ title, desc }) => (
                <div class="p-5 rounded-xl border border-gray-100 hover:border-blue-200 hover:shadow-sm transition-all">
                  <h3 class="font-bold text-blue-900 text-base mb-2">{title}</h3>
                  <p class="text-gray-500 text-sm leading-relaxed" set:html={desc}></p>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Egyéb egészségügyi szolgáltatások: white bg, 2×4 grid -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-3">Egyéb egészségügyi szolgáltatások</h2>
        <div class="w-12 h-1 bg-blue-500 rounded-full mb-5"></div>
        <p class="text-gray-600 leading-relaxed mb-8">
          A foglalkozás-egészségügyi szolgáltatásunk további feladatokat is ellát, amelyek segítik a munkáltatókat a biztonságos és egészséges munkakörnyezet fenntartásában.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          {additionalServices.map(item => (
            <div class="p-4 rounded-xl border border-gray-100 hover:border-blue-200 hover:shadow-sm transition-all text-sm text-gray-600 leading-relaxed" set:html={item}></div>
          ))}
        </div>
        <a
          href="#kapcsolat"
          class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors"
        >
          Tekintse meg aktuális árlistánkat <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Szolgáltatási helyszínek -->
    <section class="py-16 bg-blue-50">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-2xl lg:text-3xl font-bold text-blue-900 mb-3">Szolgáltatási helyszínek</h2>
        <div class="w-12 h-1 bg-blue-500 rounded-full mb-5"></div>
        <p class="text-gray-600 leading-relaxed mb-8">
          Az alkalmassági vizsgálatokat rugalmasan biztosítjuk az Ön és cége igényei szerint.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 max-w-2xl">
          <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-sm flex-1">
            <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-blue-900 mb-1">Rendelőnkben</p>
              <p class="text-gray-500 text-sm">Érd, Kossuth Lajos utca 42.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-sm flex-1">
            <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-blue-900 mb-1">Helyszíni vizsgálatok</p>
              <p class="text-gray-500 text-sm">Közvetlenül a vállalat telephelyén</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Categories heading: dark gray #363636 + bg overlay image -->
    <section class="py-16 relative overflow-hidden" style="background-color: #363636;">
      <div class="absolute inset-0 bg-cover bg-center opacity-20" style="background-image: url('/images/Nevtelen-terv-15-1-1.png');"></div>
      <div class="relative z-10 container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-2xl lg:text-3xl font-bold text-white mb-3">Foglalkozás-egészségügyi kategóriák A, B, C, D</h2>
        <div class="w-12 h-1 bg-orange-500 rounded-full mb-5"></div>
        <p class="text-gray-300 leading-relaxed">
          A törvényben előírtak szerint az egyes kategóriákba a következő munkavállalók tartoznak:
        </p>
      </div>
      </div>
    </section>

    <!-- Categories accordion: white bg -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="rounded-xl shadow-[0_10px_30px_rgba(0,0,0,0.1)] overflow-hidden mb-10">
          {categories.map(({ title, items }, i) => (
            <details class="group border-b border-gray-200 last:border-b-0">
              <summary class="flex items-center justify-between px-7 py-5 cursor-pointer list-none select-none hover:bg-gray-50 transition-colors">
                <span class="font-semibold text-blue-900 text-base">{title}</span>
                <svg class="w-5 h-5 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="px-7 pb-6 pt-2">
                <ul class="space-y-3">
                  {items.map(item => (
                    <li class="flex items-start gap-3 text-gray-600 text-sm leading-relaxed">
                      <span class="text-blue-500 mt-0.5 shrink-0">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))}
        </div>
        <p class="text-gray-600 leading-relaxed mb-6 max-w-3xl">
          A foglalkozás-egészségügyi vizsgálat biztosítja, hogy a munkavállalók biztonságosan és egészségesen végezhessék munkájukat, megfelelve a törvényi előírásoknak. Foglaljon időpontot még ma és gondoskodjon dolgozóiról!
        </p>
        <a
          href="#kapcsolat"
          class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors"
        >
          Foglaljon időpontot még ma! <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Akik már bizalmat szavaztak: logo slider -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-10">Akik már bizalmat szavaztak</h2>
        <div class="relative">
          <button id="logos-prev" aria-label="Előző" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-5 z-10 w-11 h-11 bg-orange-500 hover:bg-orange-600 text-white shadow-md flex items-center justify-center transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button id="logos-next" aria-label="Következő" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-5 z-10 w-11 h-11 bg-orange-500 hover:bg-orange-600 text-white shadow-md flex items-center justify-center transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
          <div id="logos-slider" class="logos-slider flex gap-8 overflow-x-auto items-center snap-x snap-mandatory scroll-smooth">
            {logos.map(({ src, alt }) => (
              <div class="flex-shrink-0 snap-start w-[190px] flex items-center justify-center">
                <img src={src} alt={alt} class="max-h-28 w-auto object-contain" loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <ContactForm description="Írjon nekem vagy hívjon közvetlenül (<a href='tel:+36204625517' class='font-bold text-blue-900 hover:text-orange-500 transition-colors'>+36 20 462 5517</a>) és kérjen személyre szabott ajánlatot a <a href='mailto:dr.nery.klaudia@nerymed.hu' class='font-bold text-blue-900 hover:text-orange-500 transition-colors'>dr.nery.klaudia@nerymed.hu</a>-ra!" />

  </main>

  <Footer />
</BaseLayout>

<style>
  .logos-slider::-webkit-scrollbar { display: none; }
  .logos-slider { scrollbar-width: none; }
  details summary::-webkit-details-marker { display: none; }
</style>

<script>
  const logoSlider = document.getElementById('logos-slider');
  const STEP = 218; // logo width (190) + gap (28)
  document.getElementById('logos-prev')?.addEventListener('click', () => {
    logoSlider?.scrollBy({ left: -STEP, behavior: 'smooth' });
  });
  document.getElementById('logos-next')?.addEventListener('click', () => {
    logoSlider?.scrollBy({ left: STEP, behavior: 'smooth' });
  });
</script>
