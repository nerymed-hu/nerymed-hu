---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const specializations = [
  {
    icon: '🏥',
    title: 'Háziorvosi ellátás',
    desc: 'Több mint egy évtizedes tapasztalattal rendelkezem a háziorvosi ellátás terén, ahol a betegségek megelőzése és kezelése áll a középpontban.',
  },
  {
    icon: '💉',
    title: 'Diabetológia',
    desc: 'Cukorbetegség kezelése és kontrollálása, valamint személyre szabott tanácsadás a helyes étrend és életmód kialakításához.',
  },
  {
    icon: '🌿',
    title: 'Életmódorvoslás',
    desc: 'Egészséges életmód kialakítása, egyénre szabott étrendtervezéssel és mozgásprogramokkal prevenciós fókusszal.',
  },
  {
    icon: '🏢',
    title: 'Foglalkozás-egészségügy',
    desc: 'A dolgozók egészségének megőrzése érdekében üzemorvosi vizsgálatok és egészségügyi tanácsadás vállalatok számára.',
  },
];

const lifestylePillars = [
  { icon: '🥗', label: 'Táplálkozás' },
  { icon: '🏃', label: 'Testmozgás' },
  { icon: '🚭', label: 'Káros szenvedélyek elhagyása' },
  { icon: '🧘', label: 'Stresszkezelés' },
  { icon: '😴', label: 'Alvás' },
  { icon: '🤝', label: 'Emberi kapcsolatok' },
];

const timeline = [
  { year: '2007', text: 'Általános orvosi diploma – Semmelweis Egyetem' },
  { year: '2011', text: 'Háziorvosi szakvizsga' },
  { year: '2014', text: 'Diabetológiai licence megszerzése' },
  { year: '2023', text: 'IBLM által képesített életmódorvos' },
  { year: '2023', text: 'Foglalkozás-egészségügyi szakvizsga' },
  { year: '2024', text: 'Magyar Egészségmegőrzési és Életmódorvostani Egyesület elnökségi tagja' },
];
---

<BaseLayout
  title="Bemutatkozás"
  description="Dr. Nery Klaudia Krisztina – háziorvos, diabetológus, foglalkozás-egészségügyi szakorvos és IBLM-képesített életmódorvos Érden. Több mint 15 éves tapasztalat."
>
  <Header />

  <main>

    <!-- Hero: split layout matching original -->
    <section class="bg-blue-900 relative overflow-hidden">
      <div class="absolute inset-0 bg-blue-900/50"></div>
      <div class="relative container mx-auto px-4 max-w-6xl">
        <div class="flex flex-col lg:flex-row items-stretch min-h-[560px]">

          <!-- Left: text -->
          <div class="lg:w-1/2 flex flex-col justify-center py-20 lg:pr-12 z-10">
            <p class="text-blue-300 font-semibold text-sm uppercase tracking-widest mb-3">Bemutatkozás</p>
            <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight mb-3">
              Dr. Nery Klaudia<br />Krisztina
            </h1>
            <h2 class="text-lg text-blue-200 font-medium mb-6 leading-snug">
              Háziorvos · Diabetológus ·<br />Foglalkozás-egészségügyi szakorvos · Életmódorvos
            </h2>
            <p class="text-blue-100 leading-relaxed mb-8 max-w-md">
              Üdvözlöm! Dr. Nery Klaudia vagyok, több mint 15 éve dolgozom orvosként Érden.
              A komplexebb segítségnyújtás érdekében háziorvosként, foglalkozás-egészségügyi
              szakorvosként és életmódorvosként is gyógyítok. Arra törekszem, hogy pácienseimnek
              a legjobb ellátást nyújtsam, és támogassam őket az egészséges életmód kialakításában.
            </p>
            <div>
              <a
                href="#kapcsolat"
                class="inline-block bg-blue-500 hover:bg-blue-400 text-white font-semibold px-7 py-3 rounded-full transition-colors"
              >
                Forduljon hozzám bizalommal
              </a>
            </div>
          </div>

          <!-- Right: portrait photo -->
          <div class="lg:w-1/2 relative flex justify-center lg:justify-end items-end pt-10 lg:pt-0">
            <img
              src="/images/dr-nery-hero.jpg"
              alt="Dr. Nery Klaudia Krisztina"
              class="h-[420px] lg:h-[560px] w-auto object-cover object-top rounded-t-2xl lg:rounded-t-none lg:rounded-tl-2xl shadow-2xl"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- Specializációk -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-3xl font-bold text-center text-blue-900 mb-12">Specializációk</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {specializations.map(({ icon, title, desc }) => (
            <div class="bg-white rounded-xl p-8 shadow-[0_0_30px_rgba(0,0,0,0.08)] hover:shadow-[0_10px_30px_rgba(0,0,0,0.12)] transition-shadow border border-gray-50">
              <div class="text-4xl mb-5">{icon}</div>
              <h3 class="font-bold text-blue-900 text-lg mb-3">{title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Hitvallásom -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-3xl text-center">
        <h2 class="text-3xl font-bold text-blue-900 mb-4">Hitvallásom az életmódváltás és prevenció</h2>
        <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full mb-8"></div>
        <p class="text-gray-600 leading-relaxed text-lg">
          Meggyőződésem, hogy a hosszú távú egészség titka a személyre szabott életmódváltás.
          Az egészség megőrzéséhez elengedhetetlen a helyes táplálkozás, a rendszeres mozgás,
          a káros szenvedélyek elhagyása, az alvás minőségének javítása, jó szociális kapcsolatok
          kialakítása és a prevenció — amelyekkel felvehetjük a harcot a divatdiéták hatásaival szemben.
        </p>
      </div>
    </section>

    <!-- Egyénre szabott életmódtanácsadás -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex flex-col lg:flex-row gap-12 items-start">
          <div class="lg:w-1/2">
            <h2 class="text-3xl font-bold text-blue-900 mb-4">Egyénre szabott életmódtanácsadás</h2>
            <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
            <p class="text-gray-600 leading-relaxed mb-8">
              Szolgáltatásaim magánszemélyek és cégek számára is elérhetők, személyesen vagy online
              formában. Az életmódtanácsadások során kiemelten foglalkozom az alábbiakkal:
            </p>
            <div class="flex flex-wrap gap-3 mb-10">
              {lifestylePillars.map(({ icon, label }) => (
                <div class="flex items-center gap-2 bg-blue-50 text-blue-800 rounded-full px-4 py-2 text-sm font-medium">
                  <span>{icon}</span>
                  <span>{label}</span>
                </div>
              ))}
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href="/eletmodorvoslas/maganszemelyek"
                class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors text-center"
              >
                Magánszemélyek
              </a>
              <a
                href="/eletmodorvoslas/cegeknek"
                class="border border-blue-300 text-blue-700 hover:bg-blue-50 font-medium px-6 py-3 rounded-lg transition-colors text-center"
              >
                Vállalati megoldások
              </a>
            </div>
          </div>
          <div class="lg:w-1/2">
            <div class="bg-blue-900 rounded-2xl p-8 text-white">
              <h3 class="text-xl font-bold mb-4">Foglalkozás-egészségügy a vállalatok számára</h3>
              <p class="text-blue-200 leading-relaxed mb-6">
                Egy jól szervezett foglalkozás-egészségügyi program nemcsak a dolgozók egészségét
                védi, hanem hosszú távon hozzájárul a vállalat hatékonyságához. Szolgáltatásaim
                segítik a cégeket abban, hogy megvalósítsák:
              </p>
              <ul class="space-y-3 mb-8">
                {[
                  'Munkavállalók egészségügyi problémáinak megelőzését',
                  'Helyes életmód kialakításának ösztönzését',
                  'Dolgozói elégedettség és jóllét növekedését',
                ].map(item => (
                  <li class="flex items-start gap-3 text-blue-100 text-sm">
                    <span class="text-blue-400 mt-0.5 shrink-0">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <a
                href="/foglalkozas-egeszsegugy"
                class="inline-block bg-blue-500 hover:bg-blue-400 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors text-sm"
              >
                Foglalkozás-egészségügy →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-3xl font-bold text-center text-blue-900 mb-3">Képzettségem és tapasztalatom</h2>
        <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full mb-14"></div>

        <!-- Desktop horizontal -->
        <div class="hidden md:block relative">
          <div class="absolute top-5 left-[8.33%] right-[8.33%] h-0.5 bg-blue-200"></div>
          <div class="grid grid-cols-6 gap-4">
            {timeline.map(({ year, text }) => (
              <div class="flex flex-col items-center text-center">
                <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center z-10 mb-3 shadow-md shrink-0">
                  <div class="w-3 h-3 bg-white rounded-full"></div>
                </div>
                <p class="text-blue-700 font-bold text-sm mb-1">{year}</p>
                <p class="text-gray-500 text-xs leading-snug">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Mobile vertical -->
        <div class="md:hidden space-y-6 relative">
          <div class="absolute top-0 bottom-0 left-5 w-0.5 bg-blue-200"></div>
          {timeline.map(({ year, text }) => (
            <div class="flex gap-5 items-start pl-2">
              <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center shrink-0 z-10 shadow-sm">
                <div class="w-2.5 h-2.5 bg-white rounded-full"></div>
              </div>
              <div class="pt-0.5">
                <p class="text-blue-700 font-bold text-sm">{year}</p>
                <p class="text-gray-600 text-sm">{text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Szakmai oktatások -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-3xl text-center">
        <h2 class="text-2xl font-bold text-blue-900 mb-4">Szakmai oktatások</h2>
        <p class="text-gray-600 leading-relaxed">
          Szakmai továbbképzésben is számíthatnak rám a kedves kollégák!
          Keressenek bizalommal az alábbi elérhetőségeken.
        </p>
      </div>
    </section>

    <ContactForm />

  </main>

  <Footer />
</BaseLayout>
