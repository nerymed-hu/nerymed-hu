---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const specializations = [
  { icon: '🏥', title: 'Háziorvosi ellátás', desc: 'Általános egészségügyi ellátás, megelőzés és krónikus betegségek gondozása Érden.' },
  { icon: '💉', title: 'Diabetológia', desc: 'Cukorbetegség diagnosztikája, kezelése, inzulinrezisztencia felismerése és gondozása.' },
  { icon: '🌿', title: 'Életmódorvoslás', desc: 'Tudományosan megalapozott, személyre szabott életmódváltás egyéneknek és vállalkozásoknak.' },
  { icon: '🏢', title: 'Foglalkozás-egészségügy', desc: 'Munkaköri alkalmassági vizsgálatok és teljes körű foglalkozás-egészségügyi ellátás.' },
];

const timeline = [
  { year: '2007', text: 'Általános orvosi diploma – Semmelweis Egyetem' },
  { year: '2011', text: 'Háziorvosi szakvizsga' },
  { year: '2014', text: 'Diabetológiai licence megszerzése' },
  { year: '2023', text: 'IBLM életmódorvos minősítés' },
  { year: '2023', text: 'Foglalkozás-egészségügyi szakvizsga' },
  { year: '2024', text: 'MEÉOE elnökségi tagság' },
];
---

<BaseLayout
  title="Bemutatkozás"
  description="Dr. Nery Klaudia Krisztina – háziorvos, diabetológus, foglalkozás-egészségügyi szakorvos és IBLM-képesített életmódorvos Érden. Több mint 15 éves tapasztalat."
>
  <Header />

  <main>

    <!-- Hero -->
    <section class="bg-blue-50 py-20">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center">

          <!-- Left: text -->
          <div class="lg:w-1/2 order-2 lg:order-1">
            <p class="text-blue-500 font-semibold text-sm uppercase tracking-widest mb-3">Bemutatkozás</p>
            <h1 class="text-4xl lg:text-5xl font-bold text-blue-900 leading-tight mb-5">
              Dr. Nery<br />Klaudia Krisztina
            </h1>
            <div class="flex flex-wrap gap-2 mb-6">
              {['Életmódorvos', 'Háziorvos', 'Diabetológus', 'Foglalkozás-eü.'].map(tag => (
                <span class="bg-white border border-blue-200 text-blue-600 text-sm px-3 py-1 rounded-full font-medium">{tag}</span>
              ))}
            </div>
            <p class="text-gray-600 leading-relaxed mb-8">
              Több mint 15 éve dolgozom orvosként Érden. Háziorvosként, foglalkozás-egészségügyi
              szakorvosként és életmódorvosként egyaránt segítem pácienseimet — nem csupán a
              betegségek kezelésében, hanem az egészséges életmód tartós kialakításában is.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href="/haziorvos" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors text-center">
                Időpontot foglalok
              </a>
              <a href="tel:+36204625517" class="border border-blue-300 text-blue-700 hover:bg-blue-100 font-medium px-6 py-3 rounded-lg transition-colors text-center">
                +36 20 462 5517
              </a>
            </div>
          </div>

          <!-- Right: photo + floating badges -->
          <div class="lg:w-1/2 order-1 lg:order-2 flex justify-center">
            <div class="relative">
              <img
                src="/images/dr-nery.jpg"
                alt="Dr. Nery Klaudia Krisztina"
                class="w-72 h-80 lg:w-80 lg:h-96 object-cover rounded-2xl shadow-xl"
              />
              <!-- Badge: experience -->
              <div class="absolute -bottom-5 -left-5 bg-white rounded-xl shadow-lg px-4 py-3 flex items-center gap-3">
                <div class="bg-blue-100 rounded-lg w-10 h-10 flex items-center justify-center shrink-0">
                  <span class="text-blue-700 font-bold text-sm">15+</span>
                </div>
                <div>
                  <p class="text-xs text-gray-400 leading-none mb-0.5">év</p>
                  <p class="text-sm font-semibold text-gray-800 leading-none">tapasztalat</p>
                </div>
              </div>
              <!-- Badge: IBLM -->
              <div class="absolute -top-4 -right-4 bg-white rounded-xl shadow-lg px-4 py-3">
                <p class="text-xs text-gray-400 leading-none mb-0.5">Minősítés</p>
                <p class="text-sm font-semibold text-blue-700 leading-none">IBLM életmódorvos</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Specializations -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-blue-900 mb-3">Szakterületek</h2>
          <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {specializations.map(({ icon, title, desc }) => (
            <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow border border-gray-100 border-t-4 border-t-blue-500 p-6">
              <div class="text-3xl mb-4">{icon}</div>
              <h3 class="font-bold text-blue-900 mb-2">{title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Philosophy -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-3xl text-center">
        <h2 class="text-3xl font-bold text-blue-900 mb-3">Hitvallásom</h2>
        <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full mb-8"></div>
        <p class="text-gray-600 leading-relaxed text-lg">
          Meggyőződésem, hogy a hosszú távú egészség titka a személyre szabott életmódváltás.
          Az egészség megőrzéséhez elengedhetetlen a helyes táplálkozás, a rendszeres mozgás,
          a káros szenvedélyek elhagyása, az alvás minőségének javítása, jó szociális kapcsolatok
          kialakítása és a prevenció. Ezért törekszem arra, hogy pácienseimet ne csupán gyógyítsam,
          hanem segítsem őket az egészséges életmód tartós kialakításában.
        </p>
      </div>
    </section>

    <!-- Career timeline -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-14">
          <h2 class="text-3xl font-bold text-blue-900 mb-3">Szakmai életút</h2>
          <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full"></div>
        </div>

        <!-- Desktop: horizontal timeline -->
        <div class="hidden md:block relative">
          <div class="absolute top-5 left-[8.33%] right-[8.33%] h-0.5 bg-blue-200"></div>
          <div class="grid grid-cols-6 gap-4">
            {timeline.map(({ year, text }) => (
              <div class="flex flex-col items-center text-center">
                <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center z-10 mb-3 shadow-md shrink-0">
                  <div class="w-3 h-3 bg-white rounded-full"></div>
                </div>
                <p class="text-blue-700 font-bold text-sm mb-1">{year}</p>
                <p class="text-gray-500 text-xs leading-snug">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Mobile: vertical timeline -->
        <div class="md:hidden space-y-6 relative">
          <div class="absolute top-0 bottom-0 left-5 w-0.5 bg-blue-200"></div>
          {timeline.map(({ year, text }) => (
            <div class="flex gap-5 items-start pl-2">
              <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center shrink-0 z-10 shadow-sm">
                <div class="w-2.5 h-2.5 bg-white rounded-full"></div>
              </div>
              <div class="pt-0.5">
                <p class="text-blue-700 font-bold text-sm">{year}</p>
                <p class="text-gray-600 text-sm">{text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact CTA strip -->
    <section class="bg-blue-700 py-14">
      <div class="container mx-auto px-4 max-w-5xl flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <p class="text-blue-200 text-sm mb-1">Szeretne időpontot foglalni?</p>
          <p class="text-white text-xl font-semibold">Hívjon minket vagy írjon üzenetet!</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="tel:+36204625517" class="bg-white text-blue-700 font-semibold px-5 py-2.5 rounded-lg hover:bg-blue-50 transition-colors">
            +36 20 462 5517
          </a>
          <a href="/#kapcsolat" class="border border-blue-400 text-white font-medium px-5 py-2.5 rounded-lg hover:bg-blue-600 transition-colors">
            Üzenetet küldök
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
