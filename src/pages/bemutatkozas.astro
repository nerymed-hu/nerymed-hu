---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const specializations = [
  {
    icon: 'ekit-icon ekit-icon-shield',
    title: 'Háziorvosi ellátás',
    desc: 'Több mint egy évtizedes tapasztalattal rendelkezem a háziorvosi ellátás terén, ahol a betegségek megelőzése és kezelése áll a középpontban.',
  },
  {
    icon: 'ekit-icon ekit-icon-stethoscope',
    title: 'Diabetológia',
    desc: 'Cukorbetegség kezelése és kontrollálása, valamint személyre szabott tanácsadás a helyes étrend és életmód kialakításához.',
  },
  {
    icon: 'ekit-icon ekit-icon-right-mark',
    title: 'Életmódorvoslás',
    desc: 'Egészséges életmód kialakítása, egyénre szabott étrendtervezéssel és mozgásprogramokkal prevenciós fókusszal.',
  },
  {
    icon: 'ekit-icon ekit-icon-manager',
    title: 'Foglalkozás-egészségügy',
    desc: 'A dolgozók egészségének megőrzése érdekében üzemorvosi vizsgálatok és egészségügyi tanácsadás vállalatok számára.',
  },
];

const lifestylePillars = [
  { icon: 'ekit-icon ekit-icon-cutlery',      label: 'Táplálkozás' },
  { icon: 'ekit-icon ekit-icon-physiotherapy', label: 'Testmozgás' },
  { icon: 'ekit-icon ekit-icon-leaf',          label: 'Káros szenvedélyek elhagyása' },
  { icon: 'ekit-icon ekit-icon-brain',         label: 'Stresszkezelés' },
  { icon: 'ekit-icon ekit-icon-moon',          label: 'Alvás' },
  { icon: 'ekit-icon ekit-icon-friendship',    label: 'Emberi kapcsolatok' },
];

const timeline = [
  { year: '2007', text: 'Általános orvosi diploma – Semmelweis Egyetem' },
  { year: '2011', text: 'Háziorvosi szakvizsga' },
  { year: '2014', text: 'Diabetológiai licence megszerzése' },
  { year: '2023', text: 'IBLM által képesített életmódorvos' },
  { year: '2023', text: 'Foglalkozás-egészségügyi szakvizsga' },
  { year: '2024', text: 'Magyar Egészségmegőrzési és Életmódorvostani Egyesület elnökségi tagja' },
];
---

<BaseLayout
  title="Bemutatkozás"
  description="Dr. Nery Klaudia Krisztina – háziorvos, diabetológus, foglalkozás-egészségügyi szakorvos és IBLM-képesített életmódorvos Érden. Több mint 15 éves tapasztalat."
>
  <Header />

  <main>

    <!-- Hero: white split layout matching original -->
    <section class="bg-white overflow-hidden">
      <div class="flex flex-col lg:flex-row min-h-[580px]">

        <!-- Left: text -->
        <div class="lg:w-1/2 flex flex-col justify-center py-16 px-8 lg:px-16">
          <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-3">Bemutatkozás</p>
          <h1 class="text-4xl lg:text-5xl font-bold text-blue-900 leading-tight mb-3">
            Dr. Nery Klaudia Krisztina
          </h1>
          <h2 class="text-base lg:text-lg text-orange-500 font-semibold mb-6 leading-snug">
            Háziorvos · Diabetológus · Foglalkozás-egészségügyi szakorvos · Életmódorvos
          </h2>
          <p class="text-gray-600 leading-relaxed mb-8 max-w-md">
            Üdvözlöm! <strong class="text-gray-800">Dr. Nery Klaudia</strong> vagyok, több mint 15 éve
            dolgozom orvosként Érden. A komplexebb segítségnyújtás érdekében háziorvosként, foglalkozás-egészségügyi
            szakorvosként és életmódorvosként is gyógyítok. Szakmai pályafutásom során arra törekszem, hogy
            pácienseimnek a <strong class="text-gray-800">legjobb ellátást</strong> nyújtsam, és támogassam
            őket az <strong class="text-gray-800">egészséges életmód</strong> kialakításában.
          </p>
          <div>
            <a
              href="#kapcsolat"
              class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors"
            >
              Forduljon hozzám bizalommal
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: background image with portrait overlaid bottom-left -->
        <div class="lg:w-1/2 relative min-h-[400px] lg:min-h-[580px]">
          <img
            src="/images/footer-bg.png"
            alt=""
            class="absolute inset-0 w-full h-full object-cover"
          />
          <!-- Portrait: bottom-left, white border -->
          <div class="absolute bottom-0 left-8 lg:left-12">
            <img
              src="/images/dr-nery-klaudia.jpg"
              alt="Dr. Nery Klaudia Krisztina"
              class="h-64 lg:h-80 w-auto object-cover object-top border-[10px] border-white shadow-xl"
            />
          </div>
        </div>

      </div>
    </section>

    <!-- Specializációk -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-3xl font-bold text-center text-blue-900 mb-12">Specializációk</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {specializations.map(({ icon, title, desc }) => (
            <div class="bg-white rounded-xl p-8 shadow-[0_0_30px_rgba(0,0,0,0.08)] hover:shadow-[0_10px_30px_rgba(0,0,0,0.12)] transition-shadow border border-gray-50">
              <div class="w-14 h-14 bg-blue-50 rounded-full flex items-center justify-center mb-5">
                <i class={`${icon} text-3xl text-blue-600`} aria-hidden="true"></i>
              </div>
              <h3 class="font-bold text-blue-900 text-lg mb-3">{title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Hitvallásom -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex flex-col lg:flex-row gap-12 items-center">
          <div class="lg:w-5/12 shrink-0">
            <img src="/images/hitvallasom.png" alt="Hitvallásom az életmódváltás és prevenció" class="w-full rounded-xl shadow-md object-cover" />
          </div>
          <div class="lg:w-7/12">
            <h2 class="text-3xl font-bold text-blue-900 mb-4">Hitvallásom az életmódváltás és prevenció</h2>
            <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
            <p class="text-gray-600 leading-relaxed text-base">
              Meggyőződésem, hogy a <strong class="text-gray-800">hosszú távú egészség</strong> titka a <strong class="text-gray-800">személyre szabott életmódváltás</strong>.
              Az egészség megőrzéséhez elengedhetetlen a <strong class="text-gray-800">helyes táplálkozás</strong>, a
              <strong class="text-gray-800">rendszeres mozgás</strong>, a káros szenvedélyek elhagyása, alvás minőség javítása, jó szociális
              kapcsolatok kialakítása, <strong class="text-gray-800">prevenció</strong>, amelyekkel felvehetjük a harcot a divatdiéták hatásaival szemben.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Egyénre szabott életmódtanácsadás -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-3xl font-bold text-blue-900 mb-4">Egyénre szabott életmódtanácsadás</h2>
        <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
        <p class="text-gray-600 leading-relaxed mb-8">
          Szolgáltatásaim <strong class="text-gray-800">magánszemélyek és cégek számára</strong> is elérhetők, személyesen vagy online
          formában. Az életmódtanácsadások során kiemelten foglalkozom az alábbiakkal:
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-10">
          {lifestylePillars.map(({ icon, label }) => (
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center shrink-0">
                <i class={`${icon} text-lg text-white`} aria-hidden="true"></i>
              </div>
              <span class="text-gray-700 text-sm font-medium">{label}</span>
            </div>
          ))}
        </div>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/eletmodorvoslas/maganszemelyek"
            class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
            Magánszemélyek <span aria-hidden="true">→</span>
          </a>
          <a href="/eletmodorvoslas/cegeknek"
            class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
            Vállalati megoldások <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Foglalkozás-egészségügy teaser -->
    <section class="py-20 bg-blue-900">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex flex-col lg:flex-row gap-10 items-center">
          <div class="lg:w-2/3">
            <h2 class="text-2xl lg:text-3xl font-bold text-white mb-5">Foglalkozás-egészségügy a vállalatok számára</h2>
            <p class="text-blue-200 leading-relaxed mb-6">
              Egy jól szervezett foglalkozás-egészségügyi program nemcsak a dolgozók egészségét
              védi, hanem hosszú távon hozzájárul a vállalat hatékonyságához. Szolgáltatásaim
              segítik a cégeket abban, hogy megvalósítsák:
            </p>
            <ul class="space-y-3 mb-8">
              {[
                'Munkavállalók egészségügyi problémáinak megelőzését',
                'Helyes életmód kialakításának ösztönzését',
                'Dolgozói elégedettség és jóllét növekedését',
              ].map(item => (
                <li class="flex items-start gap-3 text-blue-100 text-sm">
                  <span class="text-orange-400 mt-0.5 shrink-0">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a href="/foglalkozas-egeszsegugy"
              class="inline-flex items-center gap-2 bg-orange-500 hover:bg-white hover:text-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
              Foglalkozás-egészségügy <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="lg:w-1/3 flex justify-center">
            <div class="w-32 h-32 bg-blue-800 rounded-full flex items-center justify-center">
              <i class="ekit-icon ekit-icon-manager text-7xl text-blue-300" aria-hidden="true"></i>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-3xl font-bold text-center text-blue-900 mb-3">Képzettségem és tapasztalatom</h2>
        <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full mb-14"></div>

        <!-- Desktop horizontal -->
        <div class="hidden md:block relative">
          <div class="absolute top-5 left-[8.33%] right-[8.33%] h-0.5 bg-blue-200"></div>
          <div class="grid grid-cols-6 gap-4">
            {timeline.map(({ year, text }) => (
              <div class="flex flex-col items-center text-center">
                <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center z-10 mb-3 shadow-md shrink-0">
                  <div class="w-3 h-3 bg-white rounded-full"></div>
                </div>
                <p class="text-blue-700 font-bold text-sm mb-1">{year}</p>
                <p class="text-gray-500 text-xs leading-snug">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Mobile vertical -->
        <div class="md:hidden space-y-6 relative">
          <div class="absolute top-0 bottom-0 left-5 w-0.5 bg-blue-200"></div>
          {timeline.map(({ year, text }) => (
            <div class="flex gap-5 items-start pl-2">
              <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center shrink-0 z-10 shadow-sm">
                <div class="w-2.5 h-2.5 bg-white rounded-full"></div>
              </div>
              <div class="pt-0.5">
                <p class="text-blue-700 font-bold text-sm">{year}</p>
                <p class="text-gray-600 text-sm">{text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Szakmai oktatások -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-3xl text-center">
        <h2 class="text-2xl font-bold text-blue-900 mb-4">Szakmai oktatások</h2>
        <p class="text-gray-600 leading-relaxed">
          Szakmai továbbképzésben is számíthatnak rám a kedves kollégák!
          Keressenek bizalommal az alábbi elérhetőségeken.
        </p>
      </div>
    </section>

    <ContactForm />

  </main>

  <Footer />
</BaseLayout>
