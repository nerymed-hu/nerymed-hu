---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
import { pillarSvgs } from '../data/lifestylePillarSvgs';

const pillars = [
  {
    svg: pillarSvgs[0],
    title: 'Táplálkozás',
    desc: 'Az étel valódi gyógyszer lehet, ha megfelelően választjuk meg. Az étrendnek főként teljes értékű növényi alapú ételekre kell épülnie, amelyek gazdagok rostokban és tápanyagokban, mint például a zöldségek, gyümölcsök, hüvelyesek, teljes kiőrlésű gabonák, csonthéjasok és magvak.',
  },
  {
    svg: pillarSvgs[1],
    title: 'Testmozgás',
    desc: 'A rendszeres fizikai aktivitás elengedhetetlen az egészséges életmódhoz. Nem kell feltétlenül edzőterembe járni – egy séta, kertészkedés vagy napi tornagyakorlatok is elegendők lehetnek ahhoz, hogy javítsák az egészségi állapotot és fenntartsák a jó közérzetet.',
  },
  {
    svg: pillarSvgs[2],
    title: 'Káros szenvedélyek elhagyása',
    desc: 'A dohányzás és a túlzott alkoholfogyasztás súlyosan károsítja az egészséget. Életmódorvosként segítek a káros szenvedélyek felszámolásában, hiszen ezek elhagyásával jelentősen csökkenthetők a rákos és szív-érrendszeri betegségek kockázatai.',
  },
  {
    svg: pillarSvgs[3],
    title: 'Stresszkezelés',
    desc: 'A stressz nemcsak mentális, hanem fizikai betegségeket is okozhat. Dr. Nery Klaudia segít felismerni és kezelni a stressz okozta problémákat, valamint megtanítja a hatékony stresszkezelési technikákat, amelyek hosszú távon javítják az életminőséget.',
  },
  {
    svg: pillarSvgs[4],
    title: 'Alvás',
    desc: 'A megfelelő mennyiségű és minőségű alvás nélkülözhetetlen az immunrendszer egészséges működéséhez. Dr. Nery Klaudia tanácsokat ad arra vonatkozóan, hogyan javítsunk alvási szokásainkon a jobb pihenés érdekében.',
  },
  {
    svg: pillarSvgs[5],
    title: 'Emberi kapcsolatok',
    desc: 'A társas kapcsolatok fenntartása alapvető fontosságú a testi és lelki egészség szempontjából. A megfelelő támogatói hálózat megléte segíti a betegek gyógyulását és javítja az általános közérzetüket.',
  },
];

const successStories = [
  { slug: 'az-en-tortenetem-hogyan-talaltam-vissza-onmagamhoz-32-kilo-fogyassal', title: 'Az én történetem – hogyan találtam vissza önmagamhoz 32 kiló fogyással' },
  { slug: 'eletmodvaltas-gyerekkel-sikertortenet', title: 'Egy év, egy új élet – Köszönjük, Nery Doktornő, hogy támogatott minket az életmódváltás útján!' },
  { slug: 'koszonolevel-nery-klaudia-doktorno', title: 'Köszönőlevél Dr. Nery Klaudia doktornőnek' },
  { slug: '40-napos-bojt-sikertortenet', title: 'Sikertörténet: 40 napos húsvéti böjt – közös siker, közös fejlődés' },
  { slug: 'tudatos-varandossag-egeszseges-terhesseg', title: 'Az én sikertörténetem – Tudatos várandósság' },
  { slug: 'atvaltozas-40-kg-fogyas-tortenet', title: 'Átváltozás, avagy a fogyásom története' },
  { slug: 'eletmodvaltas-dieta-fogyas', title: 'K. Zsófia életmódváltása: orvosi támogatással a tartós fogyásért' },
];
---

<BaseLayout
  title="Életmódorvoslás – Magánszemélyeknek"
  description="Személyre szabott életmódorvoslás és longevity programok egyéneknek. Fogyás, krónikus betegségek kezelése, prevenciós tanácsadás Dr. Nery Klaudia Krisztinával."
>
  <Header />

  <main>

    <!-- Hero: image left, text right -->
    <section class="bg-white overflow-hidden">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="flex flex-col lg:flex-row items-center">

          <!-- Image – left on desktop, bottom on mobile -->
          <div class="lg:w-1/2 flex justify-start items-end pt-10 lg:pt-0 order-2 lg:order-1">
            <img
              src="/images/klaudia-uj-2.jpg"
              alt="Dr. Nery Klaudia Krisztina – életmódorvoslás magánszemélyeknek"
              class="h-[420px] lg:h-[560px] w-auto object-cover object-top rounded-t-2xl shadow-2xl"
            />
          </div>

          <!-- Text – right on desktop, top on mobile -->
          <div class="lg:w-1/2 py-20 lg:pl-12 order-1 lg:order-2">
            <h1 class="text-4xl lg:text-5xl font-bold text-blue-900 leading-tight mb-6">
              Életmódorvoslás<br />az egyének életében
            </h1>
            <p class="text-gray-500 font-semibold mb-4">Longevity programok az egészségért és a jóllétért</p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Tudta? Az életmódorvoslás egy olyan tudományosan megalapozott módszer, amely az
              egészségtelen szokásokat pozitív életmódbeli változtatásokkal helyettesíti. Célja
              nemcsak a betegségek megelőzése, hanem azok kezelése és akár visszafordítása is.
              Hiszem, hogy az életmódorvoslás hatékonyan támogatja az egészség megőrzését és
              a krónikus betegségek kezelését, mint például a cukorbetegség, szív- és érrendszeri
              betegségek vagy bizonyos autoimmun állapotok.
            </p>
            <p class="text-gray-600 leading-relaxed mb-8">
              Ismerje meg az életmódorvoslás előnyeit! Foglaljon konzultációs időpontot még ma!
            </p>
            <a href="#kapcsolat" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
              Kapcsolat <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- 6 pillars -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-3">Az életmódorvoslás 6 fő pillére</h2>
          <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full"></div>
          <p class="text-gray-500 mt-4 max-w-2xl mx-auto">
            A közös munka során az alábbi területekre koncentrálunk, hogy az egészségi állapot javuljon:
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {pillars.map(({ svg, title, desc }) => (
            <div class="bg-white rounded-xl p-7 shadow-[0_0_30px_rgba(0,0,0,0.08)] hover:shadow-[0_10px_30px_rgba(0,0,0,0.12)] transition-shadow border border-gray-50">
              <span class="block w-14 h-14 mb-4" set:html={svg} aria-hidden="true"></span>
              <h3 class="font-bold text-blue-900 text-lg mb-3">{title}</h3>
              <p class="text-gray-500 text-base leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
        <div class="text-center mt-10">
          <a href="#kapcsolat" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
            Ajánlatot kérek <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Longevity -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-6">
          A longevity koncepciója az orvostudományban, a táplálkozástudományban és az életmódkutatásban
        </h2>
        <p class="text-gray-600 leading-relaxed mb-10">
          A longevity, vagyis a hosszú és egészséges élet titka, az életmód tudatos alakításában rejlik.
          A tudományos kutatások egyre inkább igazolják, hogy a megfelelő táplálkozás, a rendszeres
          testmozgás és a stresszkezelési technikák kulcsfontosságúak a minőségi öregedés szempontjából.
          A cél nem csupán az életévek számának növelése, hanem annak biztosítása, hogy ezek az évek
          aktívan, energikusan és betegségek nélkül teljenek. A prevenció, a kiegyensúlyozott életmód
          és a mentális egészség megőrzése mind hozzájárulnak ahhoz, hogy az időskor ne a leépülés,
          hanem a vitalitás időszaka legyen.
        </p>
        <div class="text-center">
          <img
            src="/images/Hitvallasom-az-eletmodvaltas-es-prevencio.png"
            alt="Dr. Nery Klaudia Krisztina hitvallása az életmódváltás és prevenció"
            class="inline-block rounded-2xl shadow-lg max-h-[500px] w-auto object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Miért fontos -->
    <section class="py-20 bg-blue-900 text-white">
      <div class="container mx-auto px-4 max-w-[1200px] text-center">
        <h2 class="text-3xl font-bold mb-4">Miért fontos az életmódorvoslás?</h2>
        <div class="w-12 h-1 bg-blue-400 mx-auto rounded-full mb-8"></div>
        <p class="text-blue-100 leading-relaxed text-lg mb-8 max-w-3xl mx-auto">
          Az életmódorvoslás célja az, hogy minden egyén kezébe vegye az egészsége irányítását,
          és tartós változtatásokat vezessen be a mindennapi életében. A megfelelő életmód támogatja
          a szervezet öngyógyító mechanizmusait, és megelőzi a súlyos betegségek kialakulását.
          Többéves szakmai tapasztalattal a hátam mögött segíthetek Önnek is az egészséges életmód
          kialakításában, amely hosszú távon biztosítja a jóllétet és az egészség fenntartását.
        </p>
        <a href="#kapcsolat" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-8 py-3 rounded-full transition-colors">
          Kapcsolat <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Success stories -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-3">Eredmények</h2>
          <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {successStories.map(({ slug, title }) => (
            <div class="flex flex-col justify-between p-6 rounded-xl border border-gray-100 hover:border-blue-200 hover:shadow-md transition-all bg-white">
              <p class="text-gray-700 text-sm font-medium leading-snug mb-4">{title}</p>
              <a
                href={`/blog/${slug}`}
                class="inline-flex items-center gap-2 text-orange-500 hover:text-orange-600 font-semibold text-sm transition-colors"
              >
                Elolvasom <span aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Testimonials />

    <ContactForm description="Kérjen időpontot – <a href='tel:+36204625517' class='font-bold text-blue-900 hover:text-orange-500 transition-colors'>+36 20 462 5517</a> – az első konzultáció 30-60 percet vesz igénybe!" />

  </main>

  <Footer />
</BaseLayout>
