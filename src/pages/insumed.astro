---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';

const targets = [
  { icon: '⚖️', label: 'Fogyni vágyóknak' },
  { icon: '💉', label: 'Cukorbetegeknek' },
  { icon: '🌱', label: 'Vegánoknak' },
  { icon: '🏋️', label: 'Sportolóknak' },
  { icon: '👴', label: '65+ korosztálynak' },
  { icon: '🩺', label: 'Hiányos tápláltságúaknak' },
];

const benefits = [
  { icon: '🔥', label: 'Zsírból fogyás' },
  { icon: '💪', label: 'Izomzat megtartás' },
  { icon: '📉', label: 'Tartós súlycsökkenés' },
  { icon: '❤️', label: 'Javuló egészségi állapot' },
];

const steps = [
  {
    num: '1',
    title: 'Állapotfelmérés',
    desc: 'Az terápia első lépése a részletes állapotfelmérés. Ennek során nemcsak a testsúlyát és a magasságát mérjük meg, hanem a haskörfogatát, és elvégezzük a BIA-mérést is. Kikérdezzük az esetleges betegségekről, allergiákról, és szükség esetén további orvosi vizsgálatokat javasolunk.',
  },
  {
    num: '2',
    title: 'Személyre szabott tanácsadás',
    desc: 'Az eredmények alapján teljesen egyéni étrendi és életmódbeli tanácsokat kap. Megtudja, mikor, mit és mennyit egyen, valamint milyen mozgásformát érdemes választania. A rendszeres konzultációk során nyomon követjük a testösszetétel változásait.',
  },
  {
    num: '3',
    title: 'Megvalósítás és kontroll',
    desc: 'Az életmódbeli változtatásokat Ön hajtja végre, de a haladást folyamatosan ellenőrizzük. A következő tanácsadáson ismét BIA-mérést végzünk, hogy felmérjük a testösszetétel változását, és szükség esetén újabb javaslatokat tegyünk.',
  },
];

const products = [
  {
    category: 'TRINKMAHLZEIT',
    items: [
      { name: 'INSUMED Trinkmahlzeit BASIC', desc: 'Speciális gyógyászati célra szánt étkezést helyettesítő élelmiszerpor, többféle fehérjekombinációval, alacsony zsír- és szénhidráttartalommal, vitaminokkal és ásványi anyagokkal gazdagítva.' },
      { name: 'Trinkmahlzeit Vegan (SZÓJA nélkül)', desc: 'Szójamentes, borsó-, napraforgó-, tök- és mandulafehérjét tartalmaz. Laktóz- és gluténmentes. Vegánok számára ideális — a növényi rostok segítik az ásványi anyagok felszívódását.' },
      { name: 'INSUMED Trinkmahlzeit BASIC PLUS', desc: 'A BASIC-hoz képest alacsonyabb szénhidráttartalommal és magasabb élelmi rosttartalommal rendelkezik.' },
    ],
  },
  {
    category: 'EGYÉB TERMÉKEK',
    items: [
      { name: 'BESTFORM', desc: 'Hatféle fehérjét tartalmazó koncentrátum L-karnitinnel, L-glutaminnal, BCAA-val, vitaminokkal és ásványi anyagokkal. 100 g = 85 g fehérje. Fehérjehiány, szarkopénia és katabolikus állapotok kezelésére.' },
      { name: 'INSUMED SZELETEK', desc: 'Fogyókúrát segítő élelmiszerek. Citrom-túró ízű (18 g fehérje/adag) és vanília-mogyoró ízű (11 g fehérje/adag) változatban.' },
      { name: 'INSUMED LEVESEK', desc: 'Fogyókúra során ideálisak, segítik a testsúly csökkentését, és az elért testsúly hosszú távú fenntartásában is hatékonyak.' },
      { name: 'INSUMED PHYTOSHAKE – ÚJDONSÁG!', desc: 'Vegán és gluténmentes étrend-kiegészítő növényi fehérjékkel, másodlagos növényi hatóanyagokkal és enzimekkel. Gyulladáscsökkentő hatású.' },
    ],
  },
];

const faqs = [
  {
    q: 'Mi az INSUMED?',
    a: 'Az INSUMED Németországban kifejlesztett, orvosok által felügyelt terápiás módszer, amely túlsúlyosoknak, cukorbetegeknek, hiányos tápláltsági állapotúaknak, vegánoknak és sportolóknak nyújt hatékony támogatást. A program alapja a rendszeres BIA-mérés.',
  },
  {
    q: 'A termékek alkalmasak a 2-es típusú cukorbetegek számára?',
    a: 'Igen, az INSUMED BASIC, BASIC PLUS és BESTFORM termékek a 2-es típusú cukorbetegek számára is ajánlottak. A tanácsadójával mindenképp konzultáljon a megfelelő használat érdekében.',
  },
  {
    q: 'Mi az INSUMED diétaterápia célja?',
    a: 'A terápia célja nem a koplalás, hanem az egészséges, fenntartható étkezés és életmód kialakítása. Mindenki más, ezért a táplálkozásnak is személyre szabottnak kell lennie. Nincs gyors megoldás, nincsenek szigorú szabályok vagy tiltások.',
  },
];
---

<BaseLayout
  title="Insumed diétaterápia"
  description="INSUMED orvosi diétaterápia BIA-méréssel. Zsírból fogyás, izommegtartás, tartós eredmény koplalás nélkül. Dr. Nery Klaudia Krisztina INSUMED tanácsadó Érden."
>
  <Header />

  <main>

    <!-- Hero -->
    <section class="bg-blue-900 overflow-hidden">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex flex-col lg:flex-row items-center gap-0">

          <div class="lg:w-1/2 py-20 lg:pr-12">
            <p class="text-blue-300 font-semibold text-sm uppercase tracking-widest mb-3">Orvosi diétaterápia</p>
            <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight mb-4">
              INSUMED<br />diétaterápia
            </h1>
            <p class="text-blue-200 text-lg font-medium mb-4">
              Az INSUMED orvosi diéta táplálkozási koncepciója
            </p>
            <p class="text-blue-100 leading-relaxed mb-8 max-w-md">
              Az INSUMED egy orvosi diétaterápia túlsúlyosoknak, cukorbetegeknek, 65+, hiányos
              tápláltságúaknak, vegánoknak, intoleranciával küzdőknek, inzulinrezisztenseknek,
              PCOS esetén és sportolóknak. Németországban kifejlesztett, orvosok által kontrollált
              diétás rendszer.
            </p>
            <a href="#kapcsolat" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-7 py-3 rounded-full transition-colors">
              Kapcsolat
            </a>
          </div>

          <div class="lg:w-1/2 flex justify-end items-end pt-10 lg:pt-0">
            <img
              src="/images/insumed-hero.png"
              alt="INSUMED diétaterápia"
              class="w-full lg:w-auto h-[320px] lg:h-[480px] object-cover rounded-t-2xl shadow-2xl"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- Kiknek segít + Miért nem elég a mérleg -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex flex-col lg:flex-row gap-12">

          <div class="lg:w-1/2">
            <h2 class="text-2xl font-bold text-blue-900 mb-3">Kiknek segít az INSUMED?</h2>
            <div class="w-10 h-1 bg-blue-500 rounded-full mb-6"></div>
            <div class="grid grid-cols-2 gap-3">
              {targets.map(({ icon, label }) => (
                <div class="flex items-center gap-3 bg-blue-50 rounded-lg px-4 py-3">
                  <span class="text-2xl">{icon}</span>
                  <span class="text-blue-800 text-sm font-medium">{label}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="lg:w-1/2">
            <h2 class="text-2xl font-bold text-blue-900 mb-3">Miért nem elég a mérleg?</h2>
            <div class="w-10 h-1 bg-blue-500 rounded-full mb-6"></div>
            <p class="text-gray-600 leading-relaxed mb-6">
              Sokan azt gondolják, hogy a mérleg mutatja a teljes igazságot az egészségünkkel
              kapcsolatban, de ez tévedés. A fürdőszobai mérlegek nem képesek megkülönböztetni a
              zsír-, izom- és víztartalmat, ezért nem adnak pontos képet a test állapotáról.
              Az INSUMED terápiában ezért speciális BIA-mérést alkalmazunk.
            </p>
            <h3 class="font-bold text-blue-900 mb-4">Az INSUMED terápia lényege</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-5">
              A terápia célja a zsírból történő fogyás, miközben az izomzat megmarad. A BIA-méréssel
              folyamatosan nyomon követjük, hogy a fogyás valóban zsírból történik-e, elkerülve
              a jojó-effektust.
            </p>
            <div class="grid grid-cols-2 gap-3">
              {benefits.map(({ icon, label }) => (
                <div class="flex items-center gap-2 text-sm text-blue-800 font-medium">
                  <span>{icon}</span><span>{label}</span>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- BIA mérés -->
    <section class="py-20 bg-blue-50">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex flex-col lg:flex-row gap-12 items-start">
          <div class="lg:w-1/2">
            <h2 class="text-3xl font-bold text-blue-900 mb-4">Mi is az a BIA-mérés?</h2>
            <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
            <p class="text-gray-600 leading-relaxed mb-4">
              A BIA-mérés (bioimpedancia-analízis) gyors és pontos módja a testösszetétel elemzésének.
              Megmutatja, hogy a szervezet mennyi zsírt, izmot, víztartalmat és más komponenseket tartalmaz.
              Különösen hasznos túlsúly, cukorbetegség vagy alultápláltság esetén, de sportolók
              edzettségi állapotának felmérésére is kiváló.
            </p>
            <p class="text-gray-600 leading-relaxed mb-6">
              INSUMED tanácsadóként az <strong>AKERN 101 BIA műszert</strong> használom, amely rendkívül
              pontos eredményeket ad.
            </p>
            <div class="bg-white rounded-xl p-6 shadow-sm border border-blue-100">
              <h3 class="font-bold text-blue-900 mb-3">Hogyan zajlik a mérés?</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                A méréshez Önnek egy ágyra kell feküdnie, és a kezére, illetve lábára elektródákat
                helyezünk, amelyek segítségével az eszköz elektromos jeleket továbbít. A mérés rövid
                idő alatt elvégezhető, és egy számítógépes program segítségével ábrázoljuk a testösszetételt.
              </p>
            </div>
          </div>
          <div class="lg:w-1/2">
            <h2 class="text-3xl font-bold text-blue-900 mb-4">A terápia fő lépései</h2>
            <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
            <div class="space-y-6">
              {steps.map(({ num, title, desc }) => (
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center shrink-0 text-white font-bold">
                    {num}
                  </div>
                  <div>
                    <h3 class="font-bold text-blue-900 mb-1">{num}. lépés: {title}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{desc}</p>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-8">
              <a href="#kapcsolat" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-full transition-colors">
                Kapcsolat
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Products -->
    <section class="py-20 bg-blue-900 text-white">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-3">Insumed termékek</h2>
          <div class="w-12 h-1 bg-blue-400 mx-auto rounded-full mb-4"></div>
          <p class="text-blue-200 max-w-2xl mx-auto text-sm leading-relaxed">
            A termékek gyártója a németországi INSUMED cég, amely az EU egészségügyi előírásainak
            megfelelően készíti termékét. A Magyarországon elérhető termékek OGYÉI-regisztrációval rendelkeznek.
          </p>
        </div>
        {products.map(({ category, items }) => (
          <div class="mb-10">
            <h3 class="text-blue-300 font-bold text-sm uppercase tracking-widest mb-4">{category}</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {items.map(({ name, desc }) => (
                <div class="bg-white/10 hover:bg-white/20 rounded-xl p-5 transition-colors">
                  <h4 class="font-bold text-white text-sm mb-2">{name}</h4>
                  <p class="text-blue-200 text-xs leading-relaxed">{desc}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <Testimonials />

    <!-- FAQ -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-blue-900 mb-3">Gyakori kérdések</h2>
          <div class="w-12 h-1 bg-blue-500 mx-auto rounded-full"></div>
          <p class="text-gray-500 mt-4">Általános kérdése van a szolgáltatással kapcsolatban?</p>
        </div>
        <div class="space-y-4">
          {faqs.map(({ q, a }) => (
            <div class="border border-gray-100 rounded-xl p-6 hover:border-blue-200 hover:shadow-sm transition-all">
              <h3 class="font-bold text-blue-900 mb-3">{q}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ContactForm />

  </main>

  <Footer />
</BaseLayout>
