---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';

const targets = [
  {
    title: 'Fogyni vágyóknak',
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-white"><path d="M3 6h18M3 12h18M3 18h18"/><circle cx="12" cy="12" r="9"/></svg>`,
  },
  {
    title: 'Cukorbetegeknek',
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-white"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M12 8v4l3 3"/></svg>`,
  },
  {
    title: 'Vegánoknak',
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-white"><path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/><path d="M8 12s1-4 4-4 4 4 4 4"/><path d="M12 16v-4"/></svg>`,
  },
  {
    title: 'Sportolóknak',
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-white"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const steps = [
  {
    num: '1',
    title: 'Állapotfelmérés',
    desc: 'Az terápia első lépése a részletes állapotfelmérés. Ennek során nemcsak a testsúlyát és a magasságát mérjük meg, hanem a haskörfogatát, és elvégezzük a BIA-mérést is. Kikérdezzük az esetleges betegségekről, allergiákról, és szükség esetén további orvosi vizsgálatokat javasolunk.',
  },
  {
    num: '2',
    title: 'Személyre szabott tanácsadás',
    desc: 'Az eredmények alapján teljesen egyéni étrendi és életmódbeli tanácsokat kap. Megtudja, mikor, mit és mennyit egyen, valamint milyen mozgásformát érdemes választania. A rendszeres konzultációk során nyomon követjük a testösszetétel változásait.',
  },
  {
    num: '3',
    title: 'Megvalósítás és kontroll',
    desc: 'Az életmódbeli változtatásokat Ön hajtja végre, de a haladást folyamatosan ellenőrizzük. A következő tanácsadáson ismét BIA-mérést végzünk, hogy felmérjük a testösszetétel változását, és szükség esetén újabb javaslatokat tegyünk.',
  },
];

const results = [
  { slug: 'az-en-tortenetem-hogyan-talaltam-vissza-onmagamhoz-32-kilo-fogyassal', title: 'Az én történetem – hogyan találtam vissza önmagamhoz 32 kiló fogyással', image: '/images/Rozsa1.jpg' },
  { slug: 'atvaltozas-40-kg-fogyas-tortenet', title: 'Átváltozás, avagy a fogyásom története', image: '/images/zsuppan-dezso-2.jpg' },
  { slug: 'koszonolevel-nery-klaudia-doktorno', title: 'Köszönőlevél Dr. Nery Klaudia doktornőnek', image: '/images/4-7.png' },
  { slug: 'eletmodvaltas-dieta-fogyas', title: 'K. Zsófia életmódváltása: orvosi támogatással a tartós fogyásért', image: '/images/koller-zsofia-1.jpg' },
  { slug: 'eletmodvaltas-gyerekkel-sikertortenet', title: 'Egy év, egy új élet – életmódváltás orvosi támogatással', image: '/images/1-12.png' },
  { slug: '40-napos-bojt-sikertortenet', title: 'Sikertörténet: 40 napos húsvéti böjt – közös siker', image: '/images/3-8.png' },
];

const faqs = [
  {
    q: 'Mi az INSUMED?',
    a: 'Az INSUMED Németországban kifejlesztett, orvosok által felügyelt terápiás módszer, amely túlsúlyosoknak, cukorbetegeknek, hiányos tápláltsági állapotúaknak, vegánoknak és sportolóknak nyújt hatékony támogatást. A program alapja a rendszeres BIA-mérés.',
  },
  {
    q: 'Mi az INSUMED diétaterápia célja, és kiknek ajánljuk?',
    a: 'Túlsúllyal küzd? Magas a vércukorszintje? Sok diétát kipróbált már, de nem sikerült tartósan lefogynia? Állandó fáradtság, gyenge izomzat, étvágyproblémák gyötrik? Az INSUMED diétaterápia éppen Önnek szól! A terápia célja nem a koplalás, hanem az egészséges, fenntartható étkezés és életmód kialakítása.',
  },
  {
    q: 'A termékek alkalmasak a 2-es típusú cukorbetegek számára?',
    a: 'Igen, az INSUMED BASIC, BASIC PLUS és BESTFORM termékek a 2-es típusú cukorbetegek számára is ajánlottak. A tanácsadójával mindenképp konzultáljon a megfelelő használat érdekében.',
  },
  {
    q: 'Alkalmasak az INSUMED termékek sportolóknak?',
    a: 'Az INSUMED BESTFORM és Trinkmahlzeit termékek sportolók számára is kiváló választást jelentenek. Fontos, hogy tanácsadójával egyeztessen a célzott felhasználásról és az optimális adagolásról.',
  },
  {
    q: 'Mi a különbség az INSUMED BASIC, BASIC PLUS és a BESTFORM között?',
    a: 'Az INSUMED termékek közötti különbség a célnak megfelelő tápanyag-összetételben rejlik. A BASIC a klasszikus választás, a BASIC PLUS alacsonyabb szénhidráttartalommal és magasabb rosttartalommal rendelkezik. A BESTFORM kifejezetten fehérjehiányos állapotokra, szarkopéniára és sportolóknak ajánlott.',
  },
  {
    q: 'Mi a különbség a Trinkmahlzeit és a főétkezések között?',
    a: 'Az INSUMED szoftver segít meghatározni a főétkezések (reggeli, ebéd, vacsora) tápanyag-összetételét, figyelembe véve az Ön egyéni igényeit. A Trinkmahlzeit étkezést helyettesítő ital, amely pontosan meghatározott fehérje-, szénhidrát- és zsírtartalommal rendelkezik.',
  },
  {
    q: 'Az INSUMED termékek gyermekek számára is alkalmasak?',
    a: 'A Trinkmahlzeit termékek dobozán a következő figyelmeztetés található: „Gyerekeknek 14 éves kortól, a gyermekorvos által meghatározott mennyiségben adható." 14 éves kor alatt kizárólag orvosi felügyelet mellett alkalmazható.',
  },
];
---

<BaseLayout
  title="Insumed diétaterápia"
  description="INSUMED orvosi diétaterápia BIA-méréssel. Zsírból fogyás, izommegtartás, tartós eredmény koplalás nélkül. Dr. Nery Klaudia Krisztina INSUMED tanácsadó Érden."
>
  <Header />

  <main>

    <!-- Hero: insumed product image left, text right, white bg -->
    <section class="bg-white overflow-hidden">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="flex flex-col lg:flex-row items-center gap-0">

          <!-- Left: product image -->
          <div class="lg:w-1/2 flex justify-center items-center py-12 lg:py-0 order-2 lg:order-1">
            <img
              src="/images/insumed.png"
              alt="INSUMED orvosi diétaterápia termékek"
              class="w-full max-w-[460px] object-contain"
            />
          </div>

          <!-- Right: text -->
          <div class="lg:w-1/2 py-20 lg:pl-8 order-1 lg:order-2">
            <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-3">Mi az Insumed?</p>
            <h1 class="text-4xl lg:text-5xl font-bold text-blue-900 leading-tight mb-6">
              Az INSUMED orvosi diéta táplálkozási koncepciója
            </h1>
            <p class="text-gray-600 leading-relaxed mb-8">
              Az INSUMED egy orvosi diétaterápia túlsúlyosoknak, cukorbetegeknek, 65+,
              hiányos tápláltságúaknak, vegánoknak, intoleranciával küzdőknek,
              inzulinrezisztenseknek, PCOS esetén és sportolóknak.
              <strong class="text-gray-800">Németországban kifejlesztett, orvosok által kontrollált diétás rendszer.</strong>
            </p>
            <a href="#kapcsolat" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
              Kapcsolat <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Kiknek segít: 4 icon cards -->
    <section class="py-20 bg-[#F6FBFF]">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-2 text-center">Előnyök</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-10 text-center">Kiknek segít az INSUMED?</h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          {targets.map(({ title, svg }) => (
            <div class="bg-white rounded-xl p-8 shadow-sm border border-blue-50 flex flex-col items-center text-center hover:shadow-md transition-shadow">
              <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mb-4" set:html={svg}></div>
              <h3 class="font-bold text-blue-900 text-base">{title}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Miért nem elég a mérleg -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="flex flex-col lg:flex-row gap-12 items-center">
          <div class="lg:w-[45%] shrink-0">
            <img
              src="/images/merleg.png"
              alt="Miért nem elég a mérleg?"
              class="w-full rounded-2xl shadow-lg object-contain"
            />
          </div>
          <div class="lg:w-[55%]">
            <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-5">Miért nem elég a mérleg?</h2>
            <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
            <p class="text-gray-600 leading-relaxed mb-8">
              Sokan azt gondolják, hogy a mérleg mutatja a teljes igazságot az egészségünkkel
              kapcsolatban, de ez tévedés. A fürdőszobai mérlegek nem képesek megkülönböztetni a
              zsír-, izom- és víztartalmat, ezért nem adnak pontos képet a test állapotáról.
              Az INSUMED terápiában ezért speciális BIA-mérést alkalmazunk, amely részletesen
              elemzi a test összetételét.
            </p>
            <a href="#bia-meres" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
              További infók a BIA mérésről <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- INSUMED terápia lényege -->
    <section class="py-20 bg-[#F6FBFF]">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-4">Az INSUMED terápia lényege</h2>
        <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
        <p class="text-gray-600 leading-relaxed mb-8 max-w-3xl">
          Az terápia célja a zsírból történő fogyás, miközben az izomzat megmarad.
          A BIA-méréssel folyamatosan nyomon követjük, hogy a fogyás valóban zsírból
          történik-e, ezáltal elkerülve a jojó-effektust. Az eredmény: tartós súlycsökkenés
          és egészséges testösszetétel, koplalás nélkül.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
          {['Zsírból fogyás', 'Izomzat megtartás', 'Tartós súlycsökkenés', 'Javuló egészségi állapot'].map(item => (
            <div class="bg-white rounded-xl px-5 py-4 text-center shadow-sm border border-blue-100">
              <span class="text-blue-900 font-semibold text-sm">{item}</span>
            </div>
          ))}
        </div>
        <p class="text-gray-600 leading-relaxed mb-8">
          Ha szeretné pontosan megismerni testének állapotát és belevágni az egészséges
          életmódba éhezésmentesen, jelentkezzen egy INSUMED tanácsadásra!
        </p>
        <a href="#kapcsolat" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
          Kapcsolat <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Vegán vagyok -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-2">Vegán vagyok. Jól csinálom?</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-2">Az INSUMED segít a vegán táplálkozás tápanyagigényeinek kiegészítésében</h2>
        <div class="w-12 h-1 bg-blue-500 rounded-full mb-6 mt-4"></div>
        <p class="text-gray-600 leading-relaxed mb-8 max-w-3xl">
          A vegán étrend követése sok előnnyel járhat, de ha nem megfelelően állítja össze az
          ételeit, az hiányállapotokhoz vezethet. Ha szeretné meggyőződni arról, hogy vegánként
          a táplálkozása valóban megfelelő-e, érdemes ellátogatni hozzánk egy BIA-mérésre.
        </p>

        <div class="flex flex-col lg:flex-row gap-12">
          <div class="lg:w-1/2">
            <p class="font-bold text-gray-800 mb-4">Mire érdemes odafigyelni az étrend kialakításakor?</p>
            <ul class="space-y-3 mb-8">
              {[
                'Fehérjeszükséglet: Egy felnőttnek átlagosan napi 0,8 g/testsúly-kg fehérjére van szüksége, idősebb korban akár 1,2 g/testsúly-kg-ra.',
                'Növényi fehérjeforrások kombinálása: A megfelelő aminosav-ellátáshoz fontos a különféle növényi alapanyagok helyes párosítása.',
                'Fehérje- és tápanyaghiány veszélyei: A hiányos táplálkozás izomvesztéshez és egyéb egészségügyi kockázatokhoz vezethet.',
              ].map(item => (
                <li class="flex items-start gap-3 text-gray-600">
                  <span class="text-blue-600 font-bold text-xl leading-tight shrink-0">»</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="lg:w-1/2">
            <p class="font-bold text-gray-800 mb-4">Hogyan segít az INSUMED diétaterápia?</p>
            <ul class="space-y-3 mb-8">
              {[
                'A BIA-mérés megmutatja, hogy szervezet mennyi izmot, zsírt és vizet tartalmaz. Ha fehérjehiányt tapasztalunk, segítünk korrigálni azt.',
                'A tanácsadás során segítünk kialakítani a megfelelő fehérjebevitelt, miközben az étrend továbbra is vegán marad.',
                'Segítünk a változatos vegán étrend kialakításában. Az INSUMED olyan termékeket is kínál, amelyek vegán igényekre szabott megoldásokat nyújtanak.',
              ].map(item => (
                <li class="flex items-start gap-3 text-gray-600">
                  <span class="text-blue-600 font-bold text-xl leading-tight shrink-0">»</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="bg-blue-50 rounded-2xl p-7 mb-8">
          <p class="font-bold text-blue-900 mb-3">INSUMED Vegán termékek</p>
          <p class="text-gray-600 leading-relaxed mb-3">
            Az orvosi diétaterápia részeként olyan magas fehérjetartalmú, alacsony
            kalóriatartalmú vegán termékeket kínálunk, amelyek támogatják az optimális testösszetételt.
            A vegán táplálkozás és az INSUMED terápia jól kombinálható!
          </p>
          <ul class="text-gray-600 text-sm space-y-1">
            <li class="flex items-center gap-2"><span class="text-green-600 font-bold">✓</span> Szójamentes vagy szójás és laktózmentes, gluténmentes opciók</li>
            <li class="flex items-center gap-2"><span class="text-green-600 font-bold">✓</span> Csökkentett zsírtartalom és alacsony glikémiás terhelés</li>
          </ul>
        </div>

        <a href="#termekek" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
          Tovább a termékekre <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- A terápia fő lépései: dark heading banner -->
    <section class="py-14" style="background-color: #363636;">
      <div class="container mx-auto px-4 max-w-[1200px] text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-white">A terápia fő lépései</h2>
      </div>
    </section>

    <!-- Step cards: white bg -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {steps.map(({ num, title, desc }) => (
            <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
              <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold text-lg mb-5 shrink-0">
                {num}
              </div>
              <h3 class="font-bold text-blue-900 text-lg mb-3">{num}. lépés: {title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BIA mérés -->
    <section id="bia-meres" class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <div class="flex flex-col lg:flex-row gap-12 items-center">

          <!-- Image left (55%) -->
          <div class="lg:w-[55%] shrink-0">
            <img
              src="/images/Insumed-Bia-mereshez-kep-3-1-1.png"
              alt="BIA mérés – bioimpedancia-analízis"
              class="w-full rounded-2xl shadow-lg object-cover"
            />
          </div>

          <!-- Text right (45%) -->
          <div class="lg:w-[45%]">
            <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-4">Mi is az a BIA-mérés?</h2>
            <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
            <p class="text-gray-600 leading-relaxed mb-6">
              A BIA-mérés (bioimpedancia-analízis) gyors és pontos módja a testösszetétel
              elemzésének. Megmutatja, hogy a szervezet mennyi zsírt, izmot, víztartalmat és
              más komponenseket tartalmaz. Különösen hasznos túlsúly, cukorbetegség vagy
              alultápláltság esetén, de sportolók edzettségi állapotának felmérésére is kiváló.
              INSUMED tanácsadóként az <strong class="text-blue-900">AKERN 101 BIA műszert</strong> használom.
            </p>
            <div class="bg-blue-50 rounded-xl p-6 mb-6">
              <h3 class="font-bold text-blue-900 mb-3">Hogyan zajlik a mérés?</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                A méréshez Önnek egy ágyra kell feküdnie, és a kezére, illetve lábára
                elektródákat helyezünk, amelyek segítségével az eszköz elektromos jeleket
                továbbít. A mérés rövid idő alatt elvégezhető, és egy számítógépes program
                segítségével ábrázoljuk a testösszetételt.
              </p>
            </div>
            <a href="#kapcsolat" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-blue-900 text-white font-semibold px-7 py-3 rounded-full transition-colors">
              Kapcsolat <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Termékek -->
    <section id="termekek" class="py-20 bg-[#F6FBFF]">
      <div class="container mx-auto px-4 max-w-[1200px]">
        <p class="text-orange-500 font-semibold text-sm uppercase tracking-widest mb-2">Túlsúlyosoknak, Cukorbetegeknek, Hiányos Tápláltságúaknak, Sportolóknak, Vegánoknak és Vegetáriánusoknak</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-4">Insumed termékek</h2>
        <div class="w-12 h-1 bg-blue-500 rounded-full mb-6"></div>
        <p class="text-gray-600 leading-relaxed mb-12 max-w-3xl">
          A terápiás koncepciók alapvető eleme az INSUMED termékek alkalmazása, melyek célzottan
          segítik a különböző táplálkozási igényekkel rendelkező személyeket. A termékek gyártója
          a világszerte elismert németországi INSUMED cég, amely a német egészségügyi előírásainak
          megfelelően készíti termékeit.
        </p>

        <!-- TRINKMAHLZEIT -->
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden mb-6">
          <div class="flex flex-col lg:flex-row">
            <div class="lg:w-[30%] shrink-0">
