---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Insumed – Orvosi diétaterápia"
  description="Az INSUMED orvosi diéta táplálkozási koncepciója. Tartós fogyás BIA-méréssel, orvosi felügyelet mellett. Dr. Nery Klaudia Krisztina."
>
  <Header />

  <main>
    <section class="bg-blue-700 text-white py-16">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold mb-4">Mi az INSUMED?</h1>
        <p class="text-blue-100 text-lg max-w-xl">
          Az INSUMED egy Németországban kifejlesztett, orvosok által felügyelt diétás rendszer
          túlsúlyosoknak, cukorbetegeknek, vegánoknak, sportolóknak és inzulinrezisztenseknek.
        </p>
      </div>
    </section>

    <section class="py-16">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
          <div class="bg-blue-50 rounded-xl p-6 text-center">
            <div class="text-4xl font-bold text-blue-700 mb-2">4–12</div>
            <div class="text-gray-600 text-sm">hét program</div>
          </div>
          <div class="bg-blue-50 rounded-xl p-6 text-center">
            <div class="text-4xl font-bold text-blue-700 mb-2">5–25 kg</div>
            <div class="text-gray-600 text-sm">átlagos fogyás</div>
          </div>
          <div class="bg-blue-50 rounded-xl p-6 text-center">
            <div class="text-4xl font-bold text-blue-700 mb-2">100%</div>
            <div class="text-gray-600 text-sm">orvosi felügyelet</div>
          </div>
        </div>

        <div class="prose prose-gray max-w-none">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Az INSUMED orvosi diéta táplálkozási koncepciója</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            Az INSUMED egy orvosi diétaterápia túlsúlyosoknak, cukorbetegeknek, 65+, hiányos
            tápláltságúaknak, vegánoknak, intoleranciával küzdőknek, inzulinrezisztenseknek, PCOS
            esetén és sportolóknak. A terápia célja a zsírból történő fogyás, miközben az izomzat
            megmarad. A program nem a koplalásra épül, hanem az egészséges, fenntartható étkezés
            és életmód kialakítására.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 mb-4">Miért nem elég a mérleg?</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            Sokan azt gondolják, hogy a mérleg mutatja a teljes igazságot az egészségünkkel kapcsolatban,
            de ez tévedés. A fürdőszobai mérlegek nem képesek megkülönböztetni a zsír-, izom- és
            víztartalmat, ezért nem adnak pontos képet a test állapotáról. Az INSUMED terápiában ezért
            speciális BIA-mérést alkalmazunk, amely részletesen elemzi a test összetételét, és
            biztosítja, hogy a fogyás valóban zsírból történjen – elkerülve a jojó-effektust.
          </p>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
            {[
              'Zsírból fogyás',
              'Izomzat megőrzése',
              'Tartós súlycsökkenés',
              'Javuló egészségi állapot',
            ].map(item => (
              <div class="bg-blue-50 rounded-xl p-4 text-center text-sm font-medium text-blue-800">
                {item}
              </div>
            ))}
          </div>

          <h2 class="text-2xl font-bold text-gray-900 mb-4">A terápia fő lépései</h2>
          <ol class="space-y-6 text-gray-600 mb-10">
            <li class="flex gap-4">
              <span class="bg-blue-700 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shrink-0">1</span>
              <div>
                <strong class="text-gray-900">Állapotfelmérés</strong> – Nemcsak a testsúlyt és magasságot mérjük, hanem a haskörfogatot is, és elvégezzük a BIA-mérést. Kikérdezzük az esetleges betegségekről, allergiákról, és szükség esetén további orvosi vizsgálatokat javasolunk.
              </div>
            </li>
            <li class="flex gap-4">
              <span class="bg-blue-700 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shrink-0">2</span>
              <div>
                <strong class="text-gray-900">Személyre szabott tanácsadás</strong> – Az eredmények alapján teljesen egyéni étrendi és életmódbeli tanácsokat kap. Megtudja, mikor, mit és mennyit egyen, valamint milyen mozgásformát érdemes választania.
              </div>
            </li>
            <li class="flex gap-4">
              <span class="bg-blue-700 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shrink-0">3</span>
              <div>
                <strong class="text-gray-900">Megvalósítás és kontroll</strong> – Az életmódbeli változtatásokat Ön hajtja végre, de a haladást folyamatosan ellenőrizzük. A következő tanácsadáson ismét BIA-mérést végzünk, hogy felmérjük a testösszetétel változását.
              </div>
            </li>
          </ol>

          <h2 class="text-2xl font-bold text-gray-900 mb-4">Mi is az a BIA-mérés?</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            A BIA-mérés (bioimpedancia-analízis) gyors és pontos módja a testösszetétel elemzésének.
            Megmutatja, hogy a szervezet mennyi zsírt, izmot, víztartalmat és más komponenseket tartalmaz.
            Különösen hasznos túlsúly, cukorbetegség vagy alultápláltság esetén, de sportolók edzettségi
            állapotának felmérésére is kiváló. INSUMED tanácsadóként az AKERN 101 BIA műszert használom,
            amely rendkívül pontos eredményeket ad. A mérés elvégzéséhez csak egy ágyra kell feküdnie,
            és elektródákat helyezünk a kezére és lábára – a mérés rövid idő alatt elvégezhető.
          </p>

          <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-10">
            <h3 class="font-semibold text-blue-900 mb-3">Kinek ajánlott az INSUMED?</h3>
            <ul class="space-y-1 text-blue-800 text-sm">
              {[
                'Fogyni vágyóknak – tartós zsírvesztés koplalás nélkül',
                'Cukorbetegeknek (2-es típus) és inzulinrezisztenseknek',
                'PCOS esetén',
                'Vegánoknak és vegetáriánusoknak – fehérjebevitel optimalizálása',
                'Sportolóknak – izomépítés és regeneráció támogatása',
                '65+ korosztálynak – szarkopénia megelőzése',
                'Hiányos tápláltságúaknak',
              ].map(item => (
                <li class="flex items-start gap-2">
                  <span class="font-bold">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <h2 class="text-2xl font-bold text-gray-900 mb-4">INSUMED termékek</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            A terápiás koncepció alapvető eleme az INSUMED termékek alkalmazása. A termékek gyártója
            a németországi INSUMED cég, amely a német és EU-s egészségügyi előírások szigorú betartásával
            készíti el termékeit. A Magyarországon elérhető termékek OGYÉI-regisztrációval rendelkeznek.
          </p>

          <div class="space-y-6 mb-10">
            {[
              {
                name: 'INSUMED Trinkmahlzeit BASIC',
                desc: 'Speciális gyógyászati célra szánt étkezést helyettesítő élelmiszerpor, többféle fehérjekombinációval, alacsony zsír- és szénhidráttartalommal, vitaminokkal és ásványi anyagokkal. Segíti a megfelelő fehérje-, vitamin- és tápanyagbevitel biztosítását fogyókúra alatt.',
              },
              {
                name: 'INSUMED Trinkmahlzeit Vegan (szójamentes)',
                desc: 'Borsó-, napraforgó-, tök- és mandulafehérjét tartalmaz, laktóz- és gluténmentes. Kiváló választás vegánok számára. A növényi rostok segítik az ásványi anyagok felszívódását, és prebiotikumként javítják az emésztést.',
              },
              {
                name: 'INSUMED Trinkmahlzeit BASIC PLUS',
                desc: 'Alacsonyabb szénhidráttartalommal és magasabb élelmi rosttartalommal rendelkezik, mint a BASIC – így még hatékonyabban támogatja a súlycsökkentést.',
              },
              {
                name: 'BESTFORM',
                desc: 'Hatféle fehérjét tartalmazó koncentrátum L-karnitinnel, L-glutaminnal, BCAA aminosavakkal, vitaminokkal és ásványi anyagokkal. 100 grammja 85 gramm fehérjét biztosít. Ideális fehérjehiány, szarkopénia és edzés utáni regeneráció esetén. A BESTFORM Vegan változat 78 gramm növényi fehérjét tartalmaz 100 grammonként.',
              },
              {
                name: 'INSUMED Szeletek',
                desc: 'Két ízesítésben elérhetők: citrom-túró (18 g fehérje/adag) és vanília-mogyoró (11 g fehérje/adag). Praktikus választás útközben.',
              },
              {
                name: 'INSUMED Levesek',
                desc: 'Ideálisak fogyókúra során, és a testsúly megtartásához is hozzájárulnak a program befejezése után.',
              },
              {
                name: 'INSUMED PHYTOSHAKE – Újdonság!',
                desc: 'Vegán és gluténmentes étrend-kiegészítő növényi fehérjékkel, kurkuminnal, tömjénnel és bromelainnal. Gyulladáscsökkentő tulajdonságokkal rendelkezik, és hozzájárul az izomtömeg és a normál csontozat fenntartásához.',
              },
            ].map(({ name, desc }) => (
              <div class="border border-gray-200 rounded-xl p-5">
                <h3 class="font-semibold text-gray-900 mb-2">{name}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <Testimonials />
  </main>

  <ContactForm />
  <Footer />
</BaseLayout>
